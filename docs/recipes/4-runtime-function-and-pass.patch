 }
+
+TEST_CASE("recipe E: a runtime function", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("fn f(db: float) -> float { return db_to_gain(db) * 2; }", errors);
+    INFO(errors);
+    REQUIRE(jit);
+    auto f = llvm::cantFail(jit->lookup("f")).toPtr<float (*)(float)>();
+    CHECK(f(20.0f) == 20.0f);
+    CHECK(f(0.0f) == 2.0f);
+    CHECK(build("fn db_to_gain(x: float) -> float { return x; }", errors) == nullptr);
+}
