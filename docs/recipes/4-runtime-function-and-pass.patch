+// recipe F: CountFlopsPass records each function's floating-point operations after optimisation.
+// RUN: fminus %s -O2 | FileCheck %s
+
+fn softclip(x: float, drive: float) -> float {
+    let y = x * drive;
+    return y / (1.0 + abs(y));
+}
