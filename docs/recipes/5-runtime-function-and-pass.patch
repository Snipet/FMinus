diff --git a/tests/unit/CodeGenTest.cpp b/tests/unit/CodeGenTest.cpp
index c6c8659..51fb851 100644
--- a/tests/unit/CodeGenTest.cpp
+++ b/tests/unit/CodeGenTest.cpp
@@ -159,3 +159,18 @@ TEST_CASE("every semantic error is reported, in source order, as clang words it"
              "test.fm:13:20: error: too many arguments to function call, expected 0, have 1\n"
              "test.fm:13:27: error: call to undeclared function 'q'\n");
 }
+
+TEST_CASE("a runtime function is called through a prototype, or as a builtin", "[codegen]")
+{
+    std::string errors;
+    auto jit = compile("float fminus_rt_db_to_gain(float db);\n"   // C's way: declare it, call it
+                       "float f(float db) { return fminus_rt_db_to_gain(db) * 2; }\n"
+                       "float g(float db) { return db_to_gain(db); }\n",   // the language's way: a builtin name
+                       &errors);
+    INFO(errors);
+    REQUIRE(jit);
+    CHECK(lookup<float(float)>(*jit, "f")(20.0f) == 20.0f);
+    CHECK(lookup<float(float)>(*jit, "g")(0.0f) == 1.0f);
+    CHECK(errorsOf("float db_to_gain(float x) { return x; }")
+          == "test.fm:1:7: error: 'db_to_gain' is a builtin and cannot be redefined\n");
+}
