@@ -0,0 +1,13 @@
+// src/opt/Passes.h: FMinus's own passes, added to LLVM's default pipeline at its extension points.
+#pragma once
+
+namespace llvm
+{
+    class PassBuilder;
+} // namespace llvm
+
+namespace fminus::opt
+{
+    // Registers FMinus's passes with `passes`, before it builds a pipeline (support/HostTarget.cpp calls it).
+    void registerPasses(llvm::PassBuilder& passes);
+} // namespace fminus::opt
