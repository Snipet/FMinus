+// recipe 6: CountFlopsPass records each function's floating-point operations after optimisation.
+// RUN: fminus %s -O2 | FileCheck %s
+
+float softclip(float x, float drive)
+{
+    const float y = x * drive;
+    return y / (1.0f + fabsf(y));
+}
