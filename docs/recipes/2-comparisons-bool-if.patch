+
+TEST_CASE("recipe C: comparisons, bool and if", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("fn magnitude(x: float) -> float { return if x < 0 { -x } else { x }; }\n"
+                     "fn sign(x: float) -> float { return if x > 0 { 1 } else { if x < 0 { -1 } else { 0 } }; }\n"
+                     "fn positive(x: float) -> bool { return x > 0; }\n"
+                     "fn pick(c: bool, a: float, b: float) -> float { return if c { a } else { b }; }\n"
+                     "fn clip(x: float) -> float { return pick(positive(x), min(x, 1), max(x, -1)); }\n",
+                     errors);
+    INFO(errors);
+    REQUIRE(jit);
+    auto magnitude = llvm::cantFail(jit->lookup("magnitude")).toPtr<float (*)(float)>();
+    auto sign = llvm::cantFail(jit->lookup("sign")).toPtr<float (*)(float)>();
+    auto positive = llvm::cantFail(jit->lookup("positive")).toPtr<bool (*)(float)>();
+    auto clip = llvm::cantFail(jit->lookup("clip")).toPtr<float (*)(float)>();
+    CHECK(magnitude(-2.5f) == 2.5f);
+    CHECK(magnitude(3.0f) == 3.0f);
+    CHECK(sign(-4.0f) == -1.0f);
+    CHECK(sign(0.0f) == 0.0f);
+    CHECK(sign(7.0f) == 1.0f);
+    CHECK(positive(2.0f));
+    CHECK_FALSE(positive(-2.0f));
+    CHECK_FALSE(positive(std::nanf("")));
+    CHECK(clip(3.0f) == 1.0f);
+    CHECK(clip(-3.0f) == -1.0f);
+
+    CHECK(build("fn f(x: float) -> float { return if x { 1 } else { 2 }; }\n"
+                "fn g(x: float) -> float { return x + (x < 1); }\n"
+                "fn h(x: float) -> bool { return x; }\n"
+                "fn k(x: float) -> float { return if x < 1 { x } else { x < 2 }; }\n",
+                errors)
+          == nullptr);
+    CHECK(errors == "test.fm:1:34: error: the condition of an if must be bool, not float\n"
+                    "test.fm:2:36: error: the right operand must be float, not bool\n"
+                    "test.fm:3:26: error: the value 'h' returns must be bool, not float\n"
+                    "test.fm:4:34: error: the branches of an if give float and bool\n");
+}
