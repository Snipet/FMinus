diff --git a/tests/unit/RecipeTest.cpp b/tests/unit/RecipeTest.cpp
index edb467b..7773a85 100644
--- a/tests/unit/RecipeTest.cpp
+++ b/tests/unit/RecipeTest.cpp
@@ -88,3 +88,64 @@ TEST_CASE("recipe C: comparisons, bool and if", "[recipe]")
                     "test.fm:3:26: error: the value 'h' returns must be bool, not float\n"
                     "test.fm:4:34: error: the branches of an if give float and bool\n");
 }
+
+TEST_CASE("recipe D: var, assignment and while", "[recipe]")
+{
+    std::string errors;
+    std::unique_ptr<fminus::jit::Jit> jit;
+    jit = build("fn sum_to(n: float) -> float {\n"
+                "    var i = 0;\n"
+                "    var total = 0;\n"
+                "    while i < n {\n"
+                "        i = i + 1;\n"
+                "        total = total + i;\n"
+                "    }\n"
+                "    return total;\n"
+                "}\n"
+                "fn power(x: float, n: float) -> float {\n"
+                "    var result = 1;\n"
+                "    var k = 0;\n"
+                "    while k < n {\n"
+                "        let factor = x;\n"
+                "        result = result * factor;\n"
+                "        k = k + 1;\n"
+                "    }\n"
+                "    return result;\n"
+                "}\n"
+                "fn doubling(limit: float) -> float {\n"
+                "    var x = 1;\n"
+                "    while x < 1000000 {\n"
+                "        x = x * 2;\n"
+                "        while x > limit { return x; }\n"
+                "    }\n"
+                "    return 0;\n"
+                "}\n",
+                errors);
+    INFO(errors);
+    REQUIRE(jit);
+    auto sumTo = llvm::cantFail(jit->lookup("sum_to")).toPtr<float (*)(float)>();
+    auto power = llvm::cantFail(jit->lookup("power")).toPtr<float (*)(float, float)>();
+    auto doubling = llvm::cantFail(jit->lookup("doubling")).toPtr<float (*)(float)>();
+    CHECK(sumTo(4.0f) == 10.0f);
+    CHECK(sumTo(0.0f) == 0.0f);
+    CHECK(power(2.0f, 10.0f) == 1024.0f);
+    CHECK(doubling(100.0f) == 128.0f);
+
+    CHECK(build("fn f(x: float) -> float {\n"
+                "    let a = 1;\n"
+                "    a = 2;\n"
+                "    b = 3;\n"
+                "    var c = 1;\n"
+                "    c = x < 1;\n"
+                "    while x { }\n"
+                "    while x < 1 { let inner = 1; }\n"
+                "    return inner;\n"
+                "}\n",
+                errors)
+          == nullptr);
+    CHECK(errors == "test.fm:3:5: error: 'a' is not a var, so it cannot change\n"
+                    "test.fm:4:5: error: unknown variable 'b'\n"
+                    "test.fm:6:5: error: 'c' is float, not bool\n"
+                    "test.fm:7:5: error: the condition of a while must be bool, not float\n"
+                    "test.fm:9:12: error: unknown variable 'inner'\n");
+}
