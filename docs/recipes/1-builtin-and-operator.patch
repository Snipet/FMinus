diff --git a/tests/unit/RecipeTest.cpp b/tests/unit/RecipeTest.cpp
new file mode 100644
index 0000000..3e8f1bf
--- /dev/null
+++ b/tests/unit/RecipeTest.cpp
@@ -0,0 +1,52 @@
+// Recipes A and B (docs/extending.md): tanh, and the % operator.
+#include "frontend/Frontend.h"
+#include "ir/CodeGen.h"
+#include "jit/Jit.h"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <llvm/IR/LLVMContext.h>
+#include <llvm/IR/Module.h>
+#include <llvm/Support/Error.h>
+
+#include <cmath>
+#include <memory>
+#include <string>
+
+namespace
+{
+    std::unique_ptr<fminus::jit::Jit> build(const char* source, std::string& errors)
+    {
+        fminus::Diagnostics diagnostics("test.fm");
+        const auto program = fminus::frontend::parse(source, diagnostics);
+        auto context = std::make_unique<llvm::LLVMContext>();
+        auto module = program ? fminus::ir::lower(*program, *context, diagnostics) : nullptr;
+        errors = diagnostics.format();
+        if (!module)
+            return nullptr;
+        auto jit = llvm::cantFail(fminus::jit::Jit::create());
+        llvm::cantFail(jit->add(std::move(module), std::move(context)));
+        return jit;
+    }
+}
+
+TEST_CASE("recipe A: tanh", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("fn f(x: float) -> float { return tanh(x); }", errors);
+    INFO(errors);
+    REQUIRE(jit);
+    auto f = llvm::cantFail(jit->lookup("f")).toPtr<float (*)(float)>();
+    CHECK(f(0.5f) == std::tanh(0.5f));
+}
+
+TEST_CASE("recipe B: %", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("fn f(x: float, y: float) -> float { return x % y * 2; }", errors);
+    INFO(errors);
+    REQUIRE(jit);
+    auto f = llvm::cantFail(jit->lookup("f")).toPtr<float (*)(float, float)>();
+    CHECK(f(7.5f, 2.0f) == 3.0f);    // (7.5 % 2) * 2: % binds as * and /
+    CHECK(f(-7.5f, 2.0f) == -3.0f);  // the sign of the dividend
+}
