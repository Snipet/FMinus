diff --git a/tests/unit/RecipeTest.cpp b/tests/unit/RecipeTest.cpp
new file mode 100644
index 0000000..0852d62
--- /dev/null
+++ b/tests/unit/RecipeTest.cpp
@@ -0,0 +1,60 @@
+// tests/unit/RecipeTest.cpp: the recipes of docs/extending.md, one TEST_CASE each.
+#include "frontend/Frontend.h"
+#include "ir/CodeGen.h"
+#include "jit/Jit.h"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <llvm/IR/LLVMContext.h>
+#include <llvm/IR/Module.h>
+#include <llvm/Support/Error.h>
+
+#include <cmath>
+#include <memory>
+#include <string>
+
+namespace
+{
+    // The program JIT-compiled at -O2, or nothing with its errors in `errors`.
+    std::unique_ptr<fminus::jit::Jit> build(const char* source, std::string& errors)
+    {
+        fminus::Diagnostics diagnostics("test.fm");
+        const auto program = fminus::frontend::parse(source, diagnostics);
+        auto context = std::make_unique<llvm::LLVMContext>();
+        auto module = program ? fminus::ir::lower(*program, *context, diagnostics) : nullptr;
+        errors = diagnostics.format();
+        if (!module)
+            return nullptr;
+        auto jit = llvm::cantFail(fminus::jit::Jit::create());
+        llvm::cantFail(jit->add(std::move(module), std::move(context)));
+        return jit;
+    }
+
+    template <typename Function>
+    Function* lookup(fminus::jit::Jit& jit, const char* name)
+    {
+        return llvm::cantFail(jit.lookup(name)).toPtr<Function*>();
+    }
+} // namespace
+
+TEST_CASE("recipe 1: tanhf, a builtin", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("float f(float x) { return tanhf(x); }", errors);
+    INFO(errors);
+    REQUIRE(jit);
+    CHECK(lookup<float(float)>(*jit, "f")(0.5f) == std::tanh(0.5f));
+}
+
+TEST_CASE("recipe 2: % and %=", "[recipe]")
+{
+    std::string errors;
+    auto jit = build("float f(float x, float y) { return x % y * 2; }\n"
+                     "float wrap(float phase) { phase %= 1; return phase; }\n",
+                     errors);
+    INFO(errors);
+    REQUIRE(jit);
+    CHECK(lookup<float(float, float)>(*jit, "f")(7.5f, 2.0f) == 3.0f);    // (7.5 % 2) * 2: % binds as * and /
+    CHECK(lookup<float(float, float)>(*jit, "f")(-7.5f, 2.0f) == -3.0f);  // the sign of the dividend
+    CHECK(lookup<float(float)>(*jit, "wrap")(2.25f) == 0.25f);
+}
