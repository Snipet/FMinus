{
    float4 h1, h2, v1, v2;
    float iG, g2C, K11, K12, K21, att, kq, attiG, attkqiG;
    void init(float rate)
    {
        const float gC = 2.0f * 1e-9f * rate;
        iG = 1.0f / (gC + 1e-7f);
        g2C = 2.0f * gC;
        att = 220.0f / 100220.0f;
        h1 = 0;
        h2 = 0;
        v1 = 0;
        v2 = 0;
        set(0.04f);
    }
    void set(float k)
    {
        kq = k;
        K11 = -att * kq * iG;
        K12 = -att * iG;
        K21 = att * iG;
        attiG = att * iG;
        attkqiG = att * kq * iG;
    }
    float4 step(float4 in, float4 g)
    {
        const float4 p1 = att * in - attiG * h2 - attkqiG * h1;
        const float4 p2 = attiG * h1;
        const float4 gi = g * 19.3423598f;          // g / (2 Vt)
        float4 x = v1;
        float4 y = v2;
        float4 i1 = 0;
        float4 i2 = 0;
        float4 d1 = 0;
        float4 d2 = 0;
        float4 xo = 0;
        {
            const float4 t1 = tanhf(x * 19.3423598f);
            i1 = g * t1;
            d1 = gi * (1 - t1 * t1);
            y = p2 + K21 * i1;
            const float4 t2 = tanhf(y * 19.3423598f);
            i2 = g * t2;
            d2 = gi * (1 - t2 * t2);
            const float4 r = x - p1 - K11 * i1 - K12 * i2;
            const float4 dr = 1 - K11 * d1 - K12 * d2 * K21 * d1;
            xo = x;
            x = x - r / dr;
        }
        {
            const float4 t1 = tanhf(x * 19.3423598f);
            i1 = g * t1;
            d1 = gi * (1 - t1 * t1);
            y = p2 + K21 * i1;
            const float4 t2 = tanhf(y * 19.3423598f);
            i2 = g * t2;
            d2 = gi * (1 - t2 * t2);
            const float4 r = x - p1 - K11 * i1 - K12 * i2;
            const float4 dr = 1 - K11 * d1 - K12 * d2 * K21 * d1;
            xo = x;
            x = x - r / dr;
        }
        i1 = g * tanhf(x * 19.3423598f);
        y = p2 + K21 * i1;
        i2 = g * tanhf(y * 19.3423598f);
        const float4 b = (i1 + h1) * iG;
        const float4 l = (i2 + h2) * iG;
        h1 = g2C * b - h1;
        h2 = g2C * l - h2;
        v1 = x;
        v2 = y;
        return l;
    }
};

module Voice_torn2_p4_1x
{
    Svf_torn2_p4 f;
    float4 ph, lfo;
    float4 dph, dlfo;
    void init(float rate)
    {
        f.init(1 * rate);
        ph = 0;
        lfo = 0;
        dph = (float4)(110.0f / (1 * rate), 138.6f / (1 * rate), 164.8f / (1 * rate), 207.7f / (1 * rate));
        dlfo = (float4)(0.3f / (1 * rate), 0.37f / (1 * rate), 0.41f / (1 * rate), 0.53f / (1 * rate));
    }
    float4 sub()
    {
        ph = ph + dph;
        ph = ph >= 1 ? ph - 1 : ph;
        lfo = lfo + dlfo;
        lfo = lfo >= 1 ? lfo - 1 : lfo;
        const float4 cv = 2.0f * sinf(6.28318531f * lfo);      // +-2 octaves
        const float4 g = 5.9e-4f * expf(0.693147181f * cv);  // expo converter: Iabc for ~4 kHz at cv 0
        return f.step(10.0f * ph - 5.0f, g);
    }
    float4 tick()
    {
        return sub();
    }
};

float v_torn2_p4_1x(float n)
{
    Voice_torn2_p4_1x w;
    w.init(48000);
    float sum = 0;
    for (int i = 0; i < (int)n; ++i)
    {
        const float4 y = w.tick();
        sum += y.x + y.y + y.z + y.w;
    }
    return sum;
}

