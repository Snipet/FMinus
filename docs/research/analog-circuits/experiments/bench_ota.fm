module Svf_2d2_s
{
    float h1, h2, v1, v2;
    float iG, g2C, K11, K12, K21, att, kq, attiG, attkqiG;
    void init(float rate)
    {
        const float gC = 2.0f * 1e-9f * rate;
        iG = 1.0f / (gC + 1e-7f);
        g2C = 2.0f * gC;
        att = 220.0f / 100220.0f;
        h1 = 0;
        h2 = 0;
        v1 = 0;
        v2 = 0;
        set(0.04f);
    }
    void set(float k)
    {
        kq = k;
        K11 = -att * kq * iG;
        K12 = -att * iG;
        K21 = att * iG;
        attiG = att * iG;
        attkqiG = att * kq * iG;
    }
    float step(float in, float g)
    {
        const float p1 = att * in - attiG * h2 - attkqiG * h1;
        const float p2 = attiG * h1;
        const float gi = g * 19.3423598f;          // g / (2 Vt)
        float x = v1;
        float y = v2;
        float i1 = 0;
        float i2 = 0;
        float d1 = 0;
        float d2 = 0;
        float xo = 0;
        {
            const float t1 = tanhf(x * 19.3423598f);
            const float t2 = tanhf(y * 19.3423598f);
            i1 = g * t1;
            i2 = g * t2;
            d1 = gi * (1 - t1 * t1);
            d2 = gi * (1 - t2 * t2);
            const float r1 = x - p1 - K11 * i1 - K12 * i2;
            const float r2 = y - p2 - K21 * i1;
            const float a11 = 1 - K11 * d1;
            const float a12 = -K12 * d2;
            const float a21 = -K21 * d1;
            const float idet = 1 / (a11 - a12 * a21);
            x = x - (r1 - a12 * r2) * idet;
            y = y - (a11 * r2 - a21 * r1) * idet;
        }
        {
            const float t1 = tanhf(x * 19.3423598f);
            const float t2 = tanhf(y * 19.3423598f);
            i1 = g * t1;
            i2 = g * t2;
            d1 = gi * (1 - t1 * t1);
            d2 = gi * (1 - t2 * t2);
            const float r1 = x - p1 - K11 * i1 - K12 * i2;
            const float r2 = y - p2 - K21 * i1;
            const float a11 = 1 - K11 * d1;
            const float a12 = -K12 * d2;
            const float a21 = -K21 * d1;
            const float idet = 1 / (a11 - a12 * a21);
            x = x - (r1 - a12 * r2) * idet;
            y = y - (a11 * r2 - a21 * r1) * idet;
        }
        i1 = g * tanhf(x * 19.3423598f);
        i2 = g * tanhf(y * 19.3423598f);
        const float b = (i1 + h1) * iG;
        const float l = (i2 + h2) * iG;
        h1 = g2C * b - h1;
        h2 = g2C * l - h2;
        v1 = x;
        v2 = y;
        return l;
    }
};

