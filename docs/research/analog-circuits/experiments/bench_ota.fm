        v2 = 0;
        set(0.04f);
    }
    void set(float k)
    {
        kq = k;
        K11 = -att * kq * iG;
        K12 = -att * iG;
        K21 = att * iG;
        attiG = att * iG;
        attkqiG = att * kq * iG;
    }
    float4 step(float4 in, float4 g)
    {
        const float4 p1 = att * in - attiG * h2 - attkqiG * h1;
        const float4 p2 = attiG * h1;
        const float4 gi = g * 19.3423598f;          // g / (2 Vt)
        float4 x = v1;
        float4 y = v2;
        float4 i1 = 0;
        float4 i2 = 0;
        float4 d1 = 0;
        float4 d2 = 0;
        float4 xo = 0;
        {
            const float4 t1 = tanhf(x * 19.3423598f);
            i1 = g * t1;
            d1 = gi * (1 - t1 * t1);
            y = p2 + K21 * i1;
            const float4 t2 = tanhf(y * 19.3423598f);
            i2 = g * t2;
            d2 = gi * (1 - t2 * t2);
            const float4 r = x - p1 - K11 * i1 - K12 * i2;
            const float4 dr = 1 - K11 * d1 - K12 * d2 * K21 * d1;
            xo = x;
            x = x - r / dr;
        }
        {
            const float4 t1 = tanhf(x * 19.3423598f);
            i1 = g * t1;
            d1 = gi * (1 - t1 * t1);
            y = p2 + K21 * i1;
            const float4 t2 = tanhf(y * 19.3423598f);
            i2 = g * t2;
            d2 = gi * (1 - t2 * t2);
            const float4 r = x - p1 - K11 * i1 - K12 * i2;
            const float4 dr = 1 - K11 * d1 - K12 * d2 * K21 * d1;
            xo = x;
            x = x - r / dr;
        }
        const float4 i1n = i1 + d1 * (x - xo);
        i2 = i2 + d2 * K21 * (i1n - i1);
        i1 = i1n;
        y = p2 + K21 * i1;
        const float4 b = (i1 + h1) * iG;
        const float4 l = (i2 + h2) * iG;
        h1 = g2C * b - h1;
        h2 = g2C * l - h2;
        v1 = x;
        v2 = y;
        return l;
    }
};

