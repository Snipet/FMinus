// Stand-in for the library's oversampler (its API only; the real one is two halfband stages each way).
module Oversample4
{
    float last;
    void up(float x, float* restrict o4)        // one input sample -> four
    {
        o4[0] = x;
        o4[1] = x;
        o4[2] = x;
        o4[3] = x;
        last = x;
    }
    float down(const float* restrict i4)        // four -> one
    {
        return 0.25f * (i4[0] + i4[1] + i4[2] + i4[3]);
    }
    void clear() { last = 0; }
};

// screamer.cir.fm, block 2 of 3 as the generator would emit it: the clipping stage, run at 4x.
// V- = Vin (ideal op amp); Zs = R4 4.7k + C3 47n to ground; Zf = (R6 51k + Pdrive 500k) || C4 51p || D1, D2 1N914.
// Unknown: the port voltage V = Vout - Vin. States: x_C3, x_C4. Pot: drive (rank 1, in the feedback conductance).
module ScreamerClip
{
    float x_C3, x_C4;
    float g4, gc3, gc4, inA;          // rate-dependent: 1/R4, 2 C3 fs, 2 C4 fs, 1 / (g4 + gc3)
    float invB, k2, kvt, lna;         // drive-dependent: 1 / (gf + gc4), 2 Is K, 2 Is K / Vt, log(Is K / Vt)

    void init(float rate)             // rate: the oversampled rate
    {
        g4 = 1.0f / 4700.0f;
        gc3 = 2.0f * 47e-9f * rate;
        gc4 = 2.0f * 51e-12f * rate;
        inA = 1.0f / (g4 + gc3);
        x_C3 = 0;
        x_C4 = 0;
        set(0.5f);
    }

    void set(float drive)             // on the 16-sample grid of the base rate
    {
        const float d = fminf(fmaxf(drive, 0), 1);
        const float gf = 1.0f / (51000.0f + 500000.0f * d * d);   // audio taper, approximated by d^2
        invB = 1.0f / (gf + gc4);
        k2 = 2 * 2.52e-9f * invB;
        kvt = k2 / 0.045f;
        lna = logf(0.5f * kvt);
    }

    float tick(float vin)
    {
        const float va = (vin * g4 + x_C3) * inA;                   // R4-C3 node
        const float p = ((vin - va) * g4 + x_C4) * invB;            // the port's open-circuit voltage
        const float q = fabsf(p);
        const float a = 0.5f * k2;
        const float arg = (q + a) / 0.045f + lna;
        const float w = arg <= -3.34145955f ? 0
                      : arg < 8 ? ((-1.31429315e-3f * arg + 4.77593136e-2f) * arg + 3.63195266e-1f) * arg + 6.31318346e-1f
                                : arg - logf(fmaxf(arg, 8));
        float v = q + a - 0.045f * w;
        v = p < 0 ? -v : v;
        const float e = expf(v / 0.045f);
        const float ei = 1 / e;
        const float f = v - p + k2 * 0.5f * (e - ei);
        const float dd = 1 + kvt * 0.5f * (e + ei);
        v = fminf(fmaxf(v - f / dd, fminf(p, 0)), fmaxf(p, 0));
        x_C3 = 2 * gc3 * va - x_C3;
        x_C4 = 2 * gc4 * v - x_C4;
        return vin + v;                                             // Vout = Vin + V
    }
};

// The program: the dials are the pots; the circuit's own blocks do the rest.
module Effect
{
    param float drive [[fminus::range(0, 1)]] [[fminus::default(0.5)]];
    param float level [[fminus::range(-24, 12)]] [[fminus::default(-6)]];
    ScreamerClip clipL, clipR;
    Oversample4 upL, upR;
    int grid;                                                       // the absolute 16-sample grid
    float up4[4];
    float out4[4];

    void init(float rate)
    {
        clipL.init(4 * rate);
        clipR.init(4 * rate);
        grid = 0;
    }

    void process(float* restrict left, float* restrict right, int n)
    {
        for (int i = 0; i < n; ++i)
        {
            if (grid == 0)
            {
                clipL.set(drive[i]);
                clipR.set(drive[i]);
            }
            grid = grid == 15 ? 0 : grid + 1;
            const float g = expf(0.115129255f * level[i]);
            upL.up(left[i], up4);
            for (int k = 0; k < 4; ++k)
                out4[k] = clipL.tick(up4[k]);
            left[i] = g * upL.down(out4);
            upR.up(right[i], up4);
            for (int k = 0; k < 4; ++k)
                out4[k] = clipR.tick(up4[k]);
            right[i] = g * upR.down(out4);
        }
    }
};

float main(float n)
{
    ScreamerClip c;
    c.init(4 * 48000);
    c.set(1);
    float sum = 0;
    float ph = 0;
    for (int i = 0; i < (int)n; ++i)
    {
        sum += c.tick(0.3f * sinf(6.28318531f * ph));
        ph += 1000.0f / 192000.0f;
        if (ph >= 1)
            ph -= 1;
    }
    return sum;
}

float baseline(float n)
{
    float sum = 0;
    float ph = 0;
    for (int i = 0; i < (int)n; ++i)
    {
        sum += 0.3f * sinf(6.28318531f * ph);
        ph += 1000.0f / 192000.0f;
        if (ph >= 1)
            ph -= 1;
    }
    return sum;
}
