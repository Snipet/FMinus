{
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev: RelWithDebInfo, LLVM Release with assertions (the everyday build)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "FMINUS_LLVM_ASSERTIONS": "ON" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "debug: Debug (-O0 -g), LLVM Release with assertions (same LLVM flavor as dev)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "FMINUS_LLVM_ASSERTIONS": "ON" }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release: Release, LLVM Release without assertions (measure here)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FMINUS_LLVM_ASSERTIONS": "OFF" }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan: Debug + AddressSanitizer + UBSan on FMinus's code (LLVM uninstrumented)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FMINUS_LLVM_ASSERTIONS": "ON",
        "FMINUS_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "tsan: RelWithDebInfo + ThreadSanitizer on FMinus's code (LLVM uninstrumented)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FMINUS_LLVM_ASSERTIONS": "ON",
        "FMINUS_SANITIZERS": "thread"
      }
    },
    {
      "name": "inline",
      "inherits": "base",
      "displayName": "inline: dev, with LLVM built inside this tree (steps into LLVM; builds its own copy)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FMINUS_LLVM_ASSERTIONS": "ON",
        "FMINUS_LLVM_MODE": "inline",
        "FMINUS_LLVM_DEBUG_INFO": "ON"
      }
    },
    {
      "name": "xcode",
      "displayName": "xcode: an Xcode project (multi-config; LLVM from the deps cache)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-xcode",
      "cacheVariables": { "FMINUS_LLVM_ASSERTIONS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "inline", "configurePreset": "inline" },
    { "name": "xcode", "configurePreset": "xcode", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_container_overflow=0:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" }
    },
    { "name": "inline", "inherits": "base", "configurePreset": "inline" },
    { "name": "xcode", "inherits": "base", "configurePreset": "xcode", "configuration": "Debug" }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "debug",
      "steps": [
        { "type": "configure", "name": "debug" },
        { "type": "build", "name": "debug" },
        { "type": "test", "name": "debug" }
      ]
    },
    {
      "name": "release",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "tsan",
      "steps": [
        { "type": "configure", "name": "tsan" },
        { "type": "build", "name": "tsan" },
        { "type": "test", "name": "tsan" }
      ]
    },
    {
      "name": "inline",
      "steps": [
        { "type": "configure", "name": "inline" },
        { "type": "build", "name": "inline" },
        { "type": "test", "name": "inline" }
      ]
    }
  ]
}
