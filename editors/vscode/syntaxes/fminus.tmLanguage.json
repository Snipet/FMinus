{
    "name": "FMinus",
    "scopeName": "source.fminus",
    "fileTypes": ["fm"],
    "patterns": [
        { "include": "#comments" },
        { "include": "#directives" },
        { "include": "#attributes" },
        { "include": "#numbers" },
        { "include": "#modules" },
        { "include": "#enums" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants" },
        { "include": "#builtins" },
        { "include": "#functions" },
        { "include": "#members" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.fminus",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.fminus" } },
                    "endCaptures": { "0": { "name": "punctuation.definition.comment.end.fminus" } }
                },
                {
                    "name": "comment.line.double-slash.fminus",
                    "begin": "//",
                    "end": "$",
                    "beginCaptures": { "0": { "name": "punctuation.definition.comment.fminus" } },
                    "patterns": [{ "include": "#lit-directive" }]
                }
            ]
        },
        "directives": {
            "comment": "Lexer.l's directives, a line that starts with #: #include \"file\", #pragma (ignored), C's conditionals (#if, #ifdef, #ifndef, #elif, #elifdef, #elifndef, #else, #endif) and the macros they read (#define, #undef). FMinus has no other; C's are errors.",
            "patterns": [
                {
                    "name": "meta.preprocessor.include.fminus",
                    "match": "^\\s*(#)\\s*(include)\\b\\s*(\"[^\"]*\")?",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.include.fminus" },
                        "3": { "name": "string.quoted.double.include.fminus" }
                    }
                },
                {
                    "name": "meta.preprocessor.pragma.fminus",
                    "match": "^\\s*(#)\\s*(pragma)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.pragma.fminus" }
                    }
                },
                {
                    "name": "meta.preprocessor.conditional.fminus",
                    "begin": "^\\s*(#)\\s*(if|elif)\\b",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.conditional.fminus" }
                    },
                    "end": "$",
                    "patterns": [{ "include": "#directive-expression" }]
                },
                {
                    "name": "meta.preprocessor.conditional.fminus",
                    "match": "^\\s*(#)\\s*(ifdef|ifndef|elifdef|elifndef)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.conditional.fminus" },
                        "3": { "name": "entity.name.function.preprocessor.fminus" }
                    }
                },
                {
                    "name": "meta.preprocessor.conditional.fminus",
                    "match": "^\\s*(#)\\s*(else|endif)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.conditional.fminus" }
                    }
                },
                {
                    "name": "meta.preprocessor.macro.fminus",
                    "begin": "^\\s*(#)\\s*(define|undef)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)?",
                    "beginCaptures": {
                        "1": { "name": "punctuation.definition.directive.fminus" },
                        "2": { "name": "keyword.control.directive.define.fminus" },
                        "3": { "name": "entity.name.function.preprocessor.fminus" }
                    },
                    "end": "$",
                    "patterns": [{ "include": "#directive-expression" }]
                },
                {
                    "name": "invalid.illegal.directive.fminus",
                    "match": "^\\s*#\\s*\\w*"
                }
            ]
        },
        "directive-expression": {
            "comment": "An #if's or #elif's expression, or a #define's value: defined, true and false, numbers, operators, comments and the macros' names.",
            "patterns": [
                { "include": "#comments" },
                { "name": "keyword.control.directive.conditional.defined.fminus", "match": "\\bdefined\\b" },
                { "include": "#constants" },
                { "include": "#numbers" },
                { "include": "#operators" },
                { "include": "#punctuation" },
                { "name": "entity.name.function.preprocessor.fminus", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" }
            ]
        },
        "lit-directive": {
            "comment": "A lit or FileCheck line in a test: RUN:, REQUIRES:, CHECK:, CHECK-NEXT:, or a check prefix (IR:, ASM-LABEL:, ...).",
            "match": "(?<=//)\\s*([A-Z][A-Z0-9_]*(?:-(?:NEXT|SAME|NOT|DAG|LABEL|EMPTY|COUNT-[0-9]+))?:)",
            "captures": { "1": { "name": "keyword.other.directive.lit.fminus" } }
        },
        "numbers": {
            "comment": "Lexer.l's constants: hex floats, decimal floats, and hex, octal and decimal integers, with C's f suffix. 2f is an error, as in C; in 0x1F the F is a digit.",
            "patterns": [
                {
                    "name": "constant.numeric.hex.fminus",
                    "match": "\\b0[xX](?:[0-9a-fA-F]+(?:\\.[0-9a-fA-F]*)?|\\.[0-9a-fA-F]+)[pP][+-]?[0-9]+[fF]?\\b"
                },
                {
                    "name": "constant.numeric.integer.hexadecimal.fminus",
                    "match": "\\b0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.float.fminus",
                    "match": "(?:\\b[0-9]+\\.[0-9]*|(?<![\\w.])\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[fF]?|\\b[0-9]+[eE][+-]?[0-9]+[fF]?\\b"
                },
                {
                    "name": "invalid.illegal.suffix.fminus",
                    "match": "\\b[0-9]+[fF]\\b"
                },
                {
                    "name": "constant.numeric.integer.fminus",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "attributes": {
            "comment": "C23's attributes, as FMinus has them: a function's [[clang::nonblocking]] and [[clang::nonallocating]], a parameter's [[fminus::range(20, 20000)]] and [[fminus::default(-6)]], and a field's, FMinus's or the host's, in any namespace, with numbers and strings: [[ui::unit(\"dB\")]].",
            "begin": "\\[\\[",
            "end": "\\]\\]",
            "beginCaptures": { "0": { "name": "punctuation.definition.attribute.begin.fminus" } },
            "endCaptures": { "0": { "name": "punctuation.definition.attribute.end.fminus" } },
            "patterns": [
                { "name": "entity.other.attribute-name.fminus", "match": "\\b(?:[A-Za-z_][A-Za-z0-9_]*::)?[A-Za-z_][A-Za-z0-9_]*\\b" },
                { "include": "#strings" },
                { "include": "#numbers" },
                { "name": "keyword.operator.arithmetic.fminus", "match": "-" },
                { "name": "punctuation.separator.delimiter.fminus", "match": "," },
                { "name": "punctuation.section.parens.fminus", "match": "[()]" }
            ]
        },
        "strings": {
            "comment": "Lexer.l's string literals, C's, which FMinus has as an attribute's arguments: C's escapes (simple, octal, hex, and universal character names); another escape is an error, and so is a string a line ends inside.",
            "name": "string.quoted.double.fminus",
            "begin": "\"",
            "end": "(\")|$",
            "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.fminus" } },
            "endCaptures": { "1": { "name": "punctuation.definition.string.end.fminus" } },
            "patterns": [
                { "name": "constant.character.escape.fminus", "match": "\\\\(?:['\"?\\\\abfnrtv]|[0-7]{1,3}|x[0-9A-Fa-f]+|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})" },
                { "name": "invalid.illegal.unknown-escape.fminus", "match": "\\\\." }
            ]
        },
        "modules": {
            "comment": "A module's declaration, module OnePole: the keyword, and the name it declares (a type from there on).",
            "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "storage.type.module.fminus" },
                "2": { "name": "entity.name.type.module.fminus" }
            }
        },
        "enums": {
            "comment": "An enumeration's tag, enum Mode: the keyword, and the name (of a declaration, enum Mode { ... }, or the type int, enum Mode m). The keyword alone, enum { ... }, is a type's word in types.",
            "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": { "name": "storage.type.enum.fminus" },
                "2": { "name": "entity.name.type.enum.fminus" }
            }
        },
        "keywords": {
            "patterns": [
                { "name": "keyword.control.fminus", "match": "\\b(?:if|else|while|for|switch|case|default|break|continue|return|parallel)\\b" },
                { "name": "variable.language.this.fminus", "match": "\\bthis\\b" }
            ]
        },
        "types": {
            "patterns": [
                { "name": "storage.modifier.fminus", "match": "\\b(?:const|restrict|poly|param)\\b" },
                { "name": "keyword.operator.sizeof.fminus", "match": "\\bsizeof\\b" },
                { "name": "storage.type.enum.fminus", "match": "\\benum\\b" },
                { "name": "storage.type.fminus", "match": "\\b(?:void|float|double|int|bool|float2|float4|float8)\\b" }
            ]
        },
        "constants": {
            "name": "constant.language.boolean.fminus",
            "match": "\\b(?:true|false)\\b"
        },
        "builtins": {
            "comment": "The builtins: <math.h>'s float functions and its exact double ones, <stdlib.h>'s heap, the FFT, hash and randf, and the recipes' reductions, poly queries, poly loads and stores, and runtime function.",
            "match": "\\b(fabsf|sqrtf|sinf|cosf|tanf|expf|logf|floorf|fminf|fmaxf|tanhf|sqrt|fabs|floor|fmin|fmax|fma|malloc|calloc|free|fft_create|fft_create_complex|fft_forward|fft_inverse|fft_destroy|hash|randf|reduce_add|reduce_min|reduce_max|poly_lanes|poly_index|poly_load|poly_store|db_to_gain)\\s*(?=\\()",
            "captures": { "1": { "name": "support.function.builtin.fminus" } }
        },
        "functions": {
            "comment": "A name followed by (: a definition, a prototype or a call.",
            "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": { "1": { "name": "entity.name.function.fminus" } }
        },
        "members": {
            "comment": "A swizzle (v.x, v.wzyx, v.s01) or a module's field (m.y, p->y). A method's name (m.tick(x)) is left to functions.",
            "match": "(\\.|->)(?:([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\())?",
            "captures": {
                "1": { "name": "punctuation.accessor.fminus" },
                "2": { "name": "variable.other.member.fminus" }
            }
        },
        "operators": {
            "comment": "Longer spellings before their prefixes: <<= before << before <= before <, &= and && before &.",
            "patterns": [
                { "name": "keyword.operator.assignment.compound.bitwise.fminus", "match": "<<=|>>=|[&|^]=" },
                { "name": "keyword.operator.bitwise.shift.fminus", "match": "<<|>>" },
                { "name": "keyword.operator.comparison.fminus", "match": "==|!=|<=|>=|<|>" },
                { "name": "keyword.operator.logical.fminus", "match": "&&|\\|\\||!" },
                { "name": "keyword.operator.increment-decrement.fminus", "match": "\\+\\+|--" },
                { "name": "keyword.operator.assignment.compound.fminus", "match": "[+\\-*/%]=" },
                { "name": "keyword.operator.assignment.fminus", "match": "=" },
                { "name": "keyword.operator.arithmetic.fminus", "match": "[+\\-*/%]" },
                { "name": "keyword.operator.ternary.fminus", "match": "[?:]" },
                { "name": "keyword.operator.bitwise.fminus", "match": "[|^~]" },
                { "name": "keyword.operator.bitwise.fminus", "comment": "or the address-of operator: the grammar cannot tell C's two apart", "match": "&" }
            ]
        },
        "punctuation": {
            "patterns": [
                { "name": "punctuation.terminator.statement.fminus", "match": ";" },
                { "name": "punctuation.separator.delimiter.fminus", "match": "," },
                { "name": "punctuation.definition.subscript.fminus", "match": "[\\[\\]]" }
            ]
        }
    }
}
