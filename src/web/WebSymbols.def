// src/web/WebSymbols.def: every function of the web library (Web.h) generated code may call, one
// FMINUS_RUNTIME_SYMBOL(name) each, as runtime/RuntimeSymbols.def lists the runtime's. Only a build with FMINUS_WEB
// has them (fminus/Config.h's FMINUS_HAS_WEB): a file that reads this one includes fminus/Config.h and reads it under
// #if FMINUS_HAS_WEB. Add a line whenever Web.h gains a C function.
//
// An executable's C main calls the last two (support/Aot.cpp), a program never: they make a context from the
// environment, so a JIT must not define them, and the list names them through FMINUS_WEB_MAIN_SYMBOL(name), which a
// reader that reserves the names defines (ir/Constants.cpp) and support/JitRuntime.cpp does not. (A program cannot
// declare any fminus_web_ name either: ir/Functions.cpp.)
//
// The server's functions (Web.h) only in a build with FMINUS_WEB_SERVER too, under fminus/Config.h's
// FMINUS_HAS_WEB_SERVER, which a reader has included.
#ifndef FMINUS_WEB_MAIN_SYMBOL
#define FMINUS_WEB_MAIN_SYMBOL(name)
#endif
FMINUS_RUNTIME_SYMBOL(fminus_web_http_get)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_post)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_get_s)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_post_s)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_wait)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_status)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_size)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_body)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_progress)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_cancel)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_close)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_within_begin)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_within_end)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_within_abandon)
#if FMINUS_HAS_WEB_SERVER
FMINUS_RUNTIME_SYMBOL(fminus_web_http_listen)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_port)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_next)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_accept)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_next_in)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_accept_in)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_route)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_is)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_arg)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_query_float)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_query_int)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_text)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_path)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_header)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_query_text)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_reply)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_reply_bytes)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_reply_text)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_reply_buffer)
FMINUS_RUNTIME_SYMBOL(fminus_web_http_reply_written)
#endif
FMINUS_WEB_MAIN_SYMBOL(fminus_web_main_start)
FMINUS_WEB_MAIN_SYMBOL(fminus_web_main_stop)
#undef FMINUS_WEB_MAIN_SYMBOL
