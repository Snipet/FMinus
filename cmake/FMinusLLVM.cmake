# cmake/FMinusLLVM.cmake: LLVM for the JIT, behind one target, FMinus::LLVM, in one of three modes (FMINUS_LLVM_MODE):
#
#   cache   (default)  FetchContent fetches the pinned source release once into ${FMINUS_DEPS_DIR}. The first
#                      configure that asks for a flavor not built yet (LLVM's build type, assertions, targets and
#                      options) builds it and installs it under ${FMINUS_DEPS_DIR}/install/llvm-<version>-<flavor>.
#                      That takes 10-30 minutes and the output streams. After that, every configure of any build tree
#                      finds the install in seconds, and this tree's flags and sanitizers never reach LLVM.
#   inline             FetchContent_MakeAvailable: LLVM is a subproject of this build tree, so ninja tracks it and a
#                      debugger steps into it with its sources. Every build tree builds its own copy, -O2 whatever
#                      this tree's build type (FMINUS_LLVM_DEBUG_INFO adds -g).
#   system             find_package(LLVM CONFIG): an LLVM you already have, through LLVM_DIR (Homebrew's is
#                      /opt/homebrew/opt/llvm/lib/cmake/llvm).
#
# Gives FMinus::LLVM: LLVM's headers as SYSTEM includes, the libraries of FMINUS_LLVM_COMPONENTS and LLVM's
# definitions. Also gives these variables:
#   FMINUS_LLVM_PACKAGE_VERSION
#   FMINUS_LLVM_TOOLS_DIR      FileCheck, not, count, opt, llc, llvm-mca, ...
#   FMINUS_LIT_DIR             the directory holding lit's Python package; empty: `import lit` from Python's own path
#   FMINUS_LLVM_TOOL_TARGETS   inline mode only: the tool targets lit needs built
include(FetchContent)

set(FMINUS_LLVM_MODE "cache" CACHE STRING "Where LLVM comes from: cache, inline or system")
set_property(CACHE FMINUS_LLVM_MODE PROPERTY STRINGS cache inline system)
if(NOT FMINUS_LLVM_MODE MATCHES "^(cache|inline|system)$")
  message(FATAL_ERROR "FMinus: FMINUS_LLVM_MODE is '${FMINUS_LLVM_MODE}'; use cache, inline or system")
endif()
if(CMAKE_BUILD_TYPE MATCHES "^(Release|MinSizeRel)$")
  set(_fminus_llvm_assert_default OFF)
else()
  set(_fminus_llvm_assert_default ON)
endif()
option(FMINUS_LLVM_ASSERTIONS "LLVM with assertions (cache and inline modes): slower, catches malformed IR at once"
       ${_fminus_llvm_assert_default})
set(FMINUS_LLVM_BUILD_TYPE "Release" CACHE STRING "LLVM's build type in cache mode")
set_property(CACHE FMINUS_LLVM_BUILD_TYPE PROPERTY STRINGS Release RelWithDebInfo Debug MinSizeRel)
option(FMINUS_LLVM_DEBUG_INFO "Inline mode: build LLVM's code with -g" OFF)
set(FMINUS_LLVM_TARGETS "host" CACHE STRING
    "LLVM_TARGETS_TO_BUILD (cache and inline modes): host, or a list such as AArch64;X86")
set(FMINUS_LLVM_COMPONENTS
    Core OrcJIT Passes IRReader Support TargetParser
    AllTargetsAsmParsers AllTargetsCodeGens AllTargetsDescs AllTargetsDisassemblers AllTargetsInfos
    CACHE STRING "The LLVM components FMinus::LLVM links (`llvm-config --components` lists them)")
set(FMINUS_LLVM_TOOLS FileCheck not count opt llc llvm-as llvm-dis llvm-link llvm-mca llvm-objdump llvm-config
    CACHE STRING "The LLVM tools and test utilities built (and installed, in cache mode)")
set(FMINUS_LLVM_EXTRA_OPTIONS "" CACHE STRING
    "More LLVM cache settings as NAME=VALUE items (cache and inline; part of the flavor; a value cannot hold ';')")

set(FMINUS_LLVM_SOURCE_DIR "${FMINUS_DEPS_DIR}/src/llvm-project-${FMINUS_LLVM_VERSION}")
set(FMINUS_LLVM_TOOL_TARGETS "")

# ---- LLVM's settings (cache and inline modes) ------------------------------------------------------------------------
# Written as an initial-cache script: a list survives it unescaped, `cmake -C` reads it for the cache mode's build, and
# the inline mode include()s it. Its text is also the flavor's fingerprint.
set(_fminus_llvm_script "# Generated by FMinus's cmake/FMinusLLVM.cmake: one LLVM flavor's settings.\n")
function(_fminus_llvm_set name value)
  if(value MATCHES "^(ON|OFF)$")
    set(_type BOOL)
  else()
    set(_type STRING)
  endif()
  string(APPEND _fminus_llvm_script "set(${name} \"${value}\" CACHE ${_type} \"\" FORCE)\n")
  set(_fminus_llvm_script "${_fminus_llvm_script}" PARENT_SCOPE)
endfunction()

if(NOT FMINUS_LLVM_MODE STREQUAL "system")
  _fminus_llvm_set(LLVM_TARGETS_TO_BUILD "${FMINUS_LLVM_TARGETS}")
  if(FMINUS_LLVM_ASSERTIONS)
    _fminus_llvm_set(LLVM_ENABLE_ASSERTIONS ON)
  else()
    _fminus_llvm_set(LLVM_ENABLE_ASSERTIONS OFF)
  endif()
  foreach(_setting
      LLVM_ENABLE_PROJECTS=           # llvm/ only: no clang, no lld
      LLVM_ENABLE_RUNTIMES=
      LLVM_ENABLE_RTTI=ON             # FMinus's own code keeps RTTI and may subclass LLVM's classes
      LLVM_ENABLE_DUMP=ON             # dump() methods without assertions too
      LLVM_ENABLE_BINDINGS=OFF
      LLVM_ENABLE_OCAMLDOC=OFF
      LLVM_ENABLE_LIBEDIT=OFF
      LLVM_ENABLE_LIBPFM=OFF
      LLVM_ENABLE_LIBXML2=OFF
      LLVM_ENABLE_ZLIB=OFF            # no compression libraries: nothing extra for a plugin to link
      LLVM_ENABLE_ZSTD=OFF
      LLVM_ENABLE_CURL=OFF
      LLVM_ENABLE_HTTPLIB=OFF
      LLVM_ENABLE_Z3_SOLVER=OFF
      LLVM_ENABLE_FFI=OFF
      LLVM_INCLUDE_TESTS=OFF
      LLVM_INCLUDE_BENCHMARKS=OFF
      LLVM_INCLUDE_EXAMPLES=OFF
      LLVM_INCLUDE_DOCS=OFF
      LLVM_INCLUDE_UTILS=ON           # FileCheck, not, count (lit's tools)
      LLVM_BUILD_UTILS=ON
      LLVM_INSTALL_UTILS=ON
      LLVM_APPEND_VC_REV=OFF
      ${FMINUS_LLVM_EXTRA_OPTIONS})
    if(NOT _setting MATCHES "^([A-Za-z0-9_]+)=(.*)$")
      message(FATAL_ERROR "FMinus: LLVM setting '${_setting}' is not NAME=VALUE")
    endif()
    _fminus_llvm_set(${CMAKE_MATCH_1} "${CMAKE_MATCH_2}")
  endforeach()
endif()

# Declares the pinned source. A tree an earlier configure extracted (and marked with the hash) is used as it is, so a
# second build tree neither downloads nor extracts.
macro(_fminus_llvm_declare subdir)
  if(EXISTS "${FMINUS_LLVM_SOURCE_DIR}/.fminus-populated")
    file(READ "${FMINUS_LLVM_SOURCE_DIR}/.fminus-populated" _fminus_llvm_marker)
    if(_fminus_llvm_marker STREQUAL FMINUS_LLVM_SHA256)
      set(FETCHCONTENT_SOURCE_DIR_FMINUS_LLVM "${FMINUS_LLVM_SOURCE_DIR}")
    endif()
  endif()
  if(NOT FETCHCONTENT_SOURCE_DIR_FMINUS_LLVM)
    message(STATUS "FMinus: fetching llvm-project ${FMINUS_LLVM_VERSION} (179 MB) into ${FMINUS_DEPS_DIR}")
  endif()
  set(FETCHCONTENT_QUIET OFF)
  FetchContent_Declare(fminus_llvm
    URL "${FMINUS_LLVM_URL}"
    URL_HASH SHA256=${FMINUS_LLVM_SHA256}
    DOWNLOAD_EXTRACT_TIMESTAMP TRUE
    SOURCE_DIR "${FMINUS_LLVM_SOURCE_DIR}"
    SOURCE_SUBDIR ${subdir}
    SYSTEM
    EXCLUDE_FROM_ALL)
endmacro()

# After the first extraction: drops the monorepo's other projects (clang, mlir, flang, lldb, the runtimes, ...; about
# 1.5 GB) unless FMINUS_LLVM_KEEP_ALL_SOURCES, and marks the tree as complete. llvm/ builds from llvm/, cmake/,
# third-party/ and (for shared headers) libc/. The tarball stays in the first build tree's _deps/fminus_llvm-tmp/.
option(FMINUS_LLVM_KEEP_ALL_SOURCES "Keep all of llvm-project's sources, not only what llvm/ builds from" OFF)
macro(_fminus_llvm_mark_populated)
  if(NOT EXISTS "${FMINUS_LLVM_SOURCE_DIR}/.fminus-populated")
    if(NOT FMINUS_LLVM_KEEP_ALL_SOURCES)
      file(GLOB _fminus_llvm_children LIST_DIRECTORIES true "${FMINUS_LLVM_SOURCE_DIR}/*")
      foreach(_child IN LISTS _fminus_llvm_children)
        cmake_path(GET _child FILENAME _name)
        if(IS_DIRECTORY "${_child}" AND NOT _name MATCHES "^(llvm|cmake|third-party|libc)$")
          file(REMOVE_RECURSE "${_child}")
        endif()
      endforeach()
    endif()
    file(WRITE "${FMINUS_LLVM_SOURCE_DIR}/.fminus-populated" "${FMINUS_LLVM_SHA256}")
  endif()
endmacro()

if(FMINUS_LLVM_MODE STREQUAL "cache")
  # ---- cache: build each flavor once, install it, find_package it ----------------------------------------------------
  _fminus_llvm_set(CMAKE_BUILD_TYPE "${FMINUS_LLVM_BUILD_TYPE}")
  if(CMAKE_OSX_DEPLOYMENT_TARGET)
    _fminus_llvm_set(CMAKE_OSX_DEPLOYMENT_TARGET "${CMAKE_OSX_DEPLOYMENT_TARGET}")
  endif()
  if(CMAKE_OSX_ARCHITECTURES)
    _fminus_llvm_set(CMAKE_OSX_ARCHITECTURES "${CMAKE_OSX_ARCHITECTURES}")
  endif()
  if(FMINUS_LLVM_BUILD_TYPE STREQUAL "Debug")
    _fminus_llvm_set(LLVM_OPTIMIZED_TABLEGEN ON)
  endif()
  _fminus_llvm_set(LLVM_DISTRIBUTION_COMPONENTS "llvm-headers;llvm-libraries;cmake-exports;${FMINUS_LLVM_TOOLS}")

  string(SHA256 _fminus_llvm_hash "${_fminus_llvm_script}")
  string(SUBSTRING "${_fminus_llvm_hash}" 0 10 _fminus_llvm_hash)
  set(_assert "")
  if(FMINUS_LLVM_ASSERTIONS)
    set(_assert "-assert")
  endif()
  set(FMINUS_LLVM_FLAVOR "llvm-${FMINUS_LLVM_VERSION}-${FMINUS_LLVM_BUILD_TYPE}${_assert}-${_fminus_llvm_hash}")
  set(FMINUS_LLVM_PREFIX "${FMINUS_DEPS_DIR}/install/${FMINUS_LLVM_FLAVOR}")
  set(_stamp "${FMINUS_LLVM_PREFIX}/fminus-flavor.cmake")   # the flavor's settings, written once the install is whole

  set(_lock "${FMINUS_DEPS_DIR}/install/${FMINUS_LLVM_FLAVOR}.lock")
  set(_installed FALSE)
  set(_locked FALSE)
  if(EXISTS "${_stamp}")
    set(_installed TRUE)
  else()
    file(LOCK "${_lock}")   # waits while another configure builds this flavor
    set(_locked TRUE)
    if(EXISTS "${_stamp}")
      set(_installed TRUE)
    endif()
  endif()

  if(NOT _installed)
    _fminus_llvm_declare(fminus-no-cmake)   # a subdirectory that does not exist: populate only
    FetchContent_MakeAvailable(fminus_llvm)
    _fminus_llvm_mark_populated()

    # Everything that does not change the libraries stays out of the fingerprint: the prefix, compilers, launchers.
    set(_local "${_fminus_llvm_script}")
    string(APPEND _local "set(CMAKE_INSTALL_PREFIX \"${FMINUS_LLVM_PREFIX}\" CACHE PATH \"\" FORCE)\n")
    string(APPEND _local "set(CMAKE_C_COMPILER \"${CMAKE_C_COMPILER}\" CACHE FILEPATH \"\" FORCE)\n")
    string(APPEND _local "set(CMAKE_CXX_COMPILER \"${CMAKE_CXX_COMPILER}\" CACHE FILEPATH \"\" FORCE)\n")
    if(CMAKE_CXX_COMPILER_LAUNCHER)
      foreach(_lang C CXX)
        string(APPEND _local
               "set(CMAKE_${_lang}_COMPILER_LAUNCHER \"${CMAKE_CXX_COMPILER_LAUNCHER}\" CACHE STRING \"\" FORCE)\n")
      endforeach()
    endif()
    set(_bdir "${FMINUS_DEPS_DIR}/build/${FMINUS_LLVM_FLAVOR}")
    file(MAKE_DIRECTORY "${_bdir}")
    file(WRITE "${_bdir}/fminus-settings.cmake" "${_local}")

    if(CMAKE_GENERATOR MATCHES "Ninja" AND CMAKE_MAKE_PROGRAM)
      set(_gen -G Ninja "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}")
    else()
      find_program(FMINUS_NINJA ninja)
      if(FMINUS_NINJA)
        set(_gen -G Ninja "-DCMAKE_MAKE_PROGRAM=${FMINUS_NINJA}")
      else()
        set(_gen -G "Unix Makefiles")
      endif()
    endif()

    message(STATUS "FMinus: building LLVM ${FMINUS_LLVM_VERSION} as ${FMINUS_LLVM_FLAVOR} (once per flavor; "
                   "${FMINUS_DEPS_JOBS} jobs; build tree ${_bdir})")
    execute_process(
      COMMAND "${CMAKE_COMMAND}" ${_gen} -C "${_bdir}/fminus-settings.cmake"
              -S "${FMINUS_LLVM_SOURCE_DIR}/llvm" -B "${_bdir}" -Wno-dev
      RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "FMinus: configuring LLVM failed (${_rc}); build tree ${_bdir}")
    endif()
    execute_process(
      COMMAND "${CMAKE_COMMAND}" --build "${_bdir}" --target install-distribution --parallel ${FMINUS_DEPS_JOBS}
      RESULT_VARIABLE _rc)
    if(NOT _rc EQUAL 0)
      message(FATAL_ERROR "FMinus: building LLVM failed (${_rc}); build tree ${_bdir}. Reconfiguring resumes it.")
    endif()
    # lit (Python) comes with the install, so the tests need nothing from the source tree.
    file(COPY "${FMINUS_LLVM_SOURCE_DIR}/llvm/utils/lit/lit" DESTINATION "${FMINUS_LLVM_PREFIX}/utils/lit"
         PATTERN "__pycache__" EXCLUDE)
    file(WRITE "${_stamp}" "${_fminus_llvm_script}")
    message(STATUS "FMinus: LLVM ${FMINUS_LLVM_FLAVOR} installed in ${FMINUS_LLVM_PREFIX}")
  endif()
  if(_locked)
    file(LOCK "${_lock}" RELEASE)
  endif()

  find_package(LLVM ${FMINUS_LLVM_VERSION} EXACT REQUIRED CONFIG
               PATHS "${FMINUS_LLVM_PREFIX}/lib/cmake/llvm" NO_DEFAULT_PATH)
  set(FMINUS_LLVM_TOOLS_DIR "${LLVM_TOOLS_BINARY_DIR}")
  set(FMINUS_LIT_DIR "${FMINUS_LLVM_PREFIX}/utils/lit")
  separate_arguments(_fminus_llvm_defs NATIVE_COMMAND "${LLVM_DEFINITIONS}")

elseif(FMINUS_LLVM_MODE STREQUAL "inline")
  # ---- inline: LLVM is a subproject of this build tree ---------------------------------------------------------------
  file(WRITE "${PROJECT_BINARY_DIR}/fminus-llvm-settings.cmake" "${_fminus_llvm_script}")
  include("${PROJECT_BINARY_DIR}/fminus-llvm-settings.cmake")
  # LLVM's own code is built -O2 for every build type of this tree: an -O0 LLVM makes every JIT compile crawl. The
  # per-configuration flags a directory ends with are the ones its targets use, so they are swapped for LLVM's
  # subdirectory and restored after it.
  set(_fminus_llvm_cflags "-O2")
  if(FMINUS_LLVM_DEBUG_INFO)
    string(APPEND _fminus_llvm_cflags " -g")
  endif()
  if(NOT FMINUS_LLVM_ASSERTIONS)
    string(APPEND _fminus_llvm_cflags " -DNDEBUG")
  endif()
  foreach(_lang C CXX)
    foreach(_cfg DEBUG RELWITHDEBINFO RELEASE MINSIZEREL)
      set(_fminus_saved_${_lang}_${_cfg} "${CMAKE_${_lang}_FLAGS_${_cfg}}")
      set(CMAKE_${_lang}_FLAGS_${_cfg} "${_fminus_llvm_cflags}")
    endforeach()
  endforeach()

  _fminus_llvm_declare(llvm)
  FetchContent_MakeAvailable(fminus_llvm)
  _fminus_llvm_mark_populated()

  foreach(_lang C CXX)
    foreach(_cfg DEBUG RELWITHDEBINFO RELEASE MINSIZEREL)
      set(CMAKE_${_lang}_FLAGS_${_cfg} "${_fminus_saved_${_lang}_${_cfg}}")
    endforeach()
  endforeach()

  # What LLVMConfig.cmake would give, read from LLVM's directory (llvm_map_components_to_libnames reads these too).
  set(_llvm_dir "${FMINUS_LLVM_SOURCE_DIR}/llvm")
  foreach(_v LLVM_PACKAGE_VERSION LLVM_TARGETS_TO_BUILD LLVM_ALL_TARGETS LLVM_NATIVE_ARCH LLVM_TARGETS_WITH_JIT
             LLVM_HOST_TRIPLE LLVM_INCLUDE_DIR LLVM_MAIN_INCLUDE_DIR LLVM_RUNTIME_OUTPUT_INTDIR LLVM_COMMON_DEPENDS)
    get_directory_property(${_v} DIRECTORY "${_llvm_dir}" DEFINITION ${_v})
  endforeach()
  get_directory_property(_fminus_llvm_defs DIRECTORY "${_llvm_dir}" COMPILE_DEFINITIONS)
  set(LLVM_INCLUDE_DIRS "${LLVM_MAIN_INCLUDE_DIR}" "${LLVM_INCLUDE_DIR}")
  set(FMINUS_LLVM_TOOLS_DIR "${LLVM_RUNTIME_OUTPUT_INTDIR}")
  set(FMINUS_LIT_DIR "${_llvm_dir}/utils/lit")
  foreach(_t IN LISTS FMINUS_LLVM_TOOLS)
    if(TARGET ${_t})
      list(APPEND FMINUS_LLVM_TOOL_TARGETS ${_t})
    endif()
  endforeach()

else()
  # ---- system: an existing LLVM --------------------------------------------------------------------------------------
  find_package(LLVM REQUIRED CONFIG)
  set(FMINUS_LLVM_TOOLS_DIR "${LLVM_TOOLS_BINARY_DIR}")
  set(FMINUS_LIT_DIR "")
  if(LLVM_BUILD_MAIN_SRC_DIR AND EXISTS "${LLVM_BUILD_MAIN_SRC_DIR}/utils/lit/lit/__init__.py")
    set(FMINUS_LIT_DIR "${LLVM_BUILD_MAIN_SRC_DIR}/utils/lit")   # an LLVM build tree: its own lit
  elseif(EXISTS "${LLVM_INSTALL_PREFIX}/utils/lit/lit/__init__.py")
    set(FMINUS_LIT_DIR "${LLVM_INSTALL_PREFIX}/utils/lit")       # an install from FMinus's deps cache
  endif()
  separate_arguments(_fminus_llvm_defs NATIVE_COMMAND "${LLVM_DEFINITIONS}")
  if(NOT LLVM_ENABLE_RTTI)
    message(WARNING "FMinus: the LLVM at ${LLVM_DIR} was built without RTTI: FMinus code that subclasses LLVM's "
                    "classes needs -fno-rtti")
  endif()
endif()

set(FMINUS_LLVM_PACKAGE_VERSION "${LLVM_PACKAGE_VERSION}")

# ---- FMinus::LLVM ---------------------------------------------------------------------------------------------------
add_library(fminus_llvm INTERFACE)
add_library(FMinus::LLVM ALIAS fminus_llvm)
target_include_directories(fminus_llvm SYSTEM INTERFACE ${LLVM_INCLUDE_DIRS})
target_compile_definitions(fminus_llvm INTERFACE ${_fminus_llvm_defs})
llvm_map_components_to_libnames(_fminus_llvm_libs ${FMINUS_LLVM_COMPONENTS})
target_link_libraries(fminus_llvm INTERFACE ${_fminus_llvm_libs})
if(FMINUS_LLVM_MODE STREQUAL "inline")
  # LLVM's generated headers (Intrinsics*.h, the target parsers' tables, ...) before any FMinus source compiles.
  foreach(_dep IN LISTS LLVM_COMMON_DEPENDS)
    if(TARGET ${_dep})
      add_dependencies(fminus_llvm ${_dep})
    endif()
  endforeach()
endif()

message(STATUS "FMinus: LLVM ${FMINUS_LLVM_PACKAGE_VERSION} (${FMINUS_LLVM_MODE}), targets ${LLVM_TARGETS_TO_BUILD}, "
               "native ${LLVM_NATIVE_ARCH}")
