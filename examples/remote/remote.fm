// examples/remote/remote.fm: a small synthesiser a browser controls (docs/web.md, "The server"). Remote plays a sine
// whose gain and pitch a page sets over HTTP, and keeps a meter the page reads. It takes its requests itself, in its
// [[clang::nonblocking]] process, between two blocks, with a serve statement: the audio thread's own work, wait-free,
// with no lock and no second thread ever touching gain or pitch. Its routes are literals with typed parameters, so its
// host sees them, and their ranges, before anything runs (Program::webRoutes), and the library answers 404 and 405
// itself for anything else. Each route answers with a reply, which the compiler checks every path reaches. Where it
// listens is the host's: http_listen() takes no argument, and under the default policy listens nowhere.
//
// The page (page/index.html and page/remote.js) is the host's to hand over as static content: remote.cpp gives the
// files to Options::web.server.files, and the driver reads the directory with --web-root (README.md). Remote is there
// only in a build with the web server and the JSON writer its replies use (#if defined(__FMINUS_WEB_SERVER__) && ...),
// so the file compiles in every build.

#if defined(__FMINUS_WEB_SERVER__) && defined(__FMINUS_JSON__)
module Remote
{
    http_server server;
    float rate;       // the sample rate, Hz
    float gain;       // as the page last set it: 0 to 1
    float pitch;      // Hz: 20 to 20000
    float heard;      // the gain as it is heard: it moves to `gain` over a few milliseconds, so a step does not click
    float phase;      // the sine's, in cycles: 0 to 1
    float level;      // the meter: the output's peak, held, a tenth less each block it is not reached again
    int changes;      // requests that changed gain or pitch

    // Off the audio thread, once: listens where the host's policy says (nowhere, by default), at once.
    void init(float sampleRate)
    {
        server = http_listen();
        rate = sampleRate;
        gain = 0.25f;
        pitch = 440.0f;
        heard = gain;
    }

    // The port it listens on, or why it does not: HTTP_REFUSED (its host allowed none), HTTP_TRANSPORT (the address
    // could not be bound), HTTP_CANCELLED (the host stopped it).
    int port() [[clang::nonblocking]]
    {
        return http_port(server);
    }

    // On the audio thread: the requests waiting for its routes, answered, then the block, with gain and pitch as they
    // now are. Only these routes reach it: the library answers 404 for a path none of them has and 405 for a method
    // none has for its path. A parameter that is missing, not a number (?value=nan) or out of its range is answered
    // 400 before its route runs, and nothing changes; a number of the path that is no number does not match (404).
    void process(float* out, int n) [[clang::nonblocking]]
    {
        serve (server)                                                   // wait-free: each request waiting, or none
        {
            route "POST /gain" (float value [[fminus::range(0, 1)]])     // POST /gain?value=0.5
            {
                gain = value;
                changes += 1;
                reply 204;
            }
            route "POST /pitch" (float value [[fminus::range(20, 20000)]])   // POST /pitch?value=261.63
            {
                pitch = value;
                changes += 1;
                reply 204;
            }
            route "POST /note/{note}" (int note [[fminus::range(0, 127)]])  // POST /note/69: A4, 440 Hz
            {
                pitch = 440.0f * expf(0.05776227f * (float)(note - 69));   // 2^((note - 69) / 12)
                changes += 1;
                reply 204;
            }
            route "GET /state"                                           // what the page shows
            {
                reply 200, json { gain, pitch, level, changes };         // {"gain":0.25,"pitch":440,...}
            }
        }
        const float step = pitch / rate;
        float peak = 0.0f;
        for (int i = 0; i < n; ++i)
        {
            heard += (gain - heard) * 0.002f;
            out[i] = heard * sinf(6.2831853f * phase);
            phase += step;
            if (phase >= 1.0f)
                phase -= 1.0f;
            peak = fmaxf(peak, fabsf(out[i]));
        }
        level = fmaxf(peak, level * 0.9f);
    }

    // For the driver, which has no audio thread (README.md): renders blocks of 10 ms for about `seconds` seconds, and
    // between two waits up to a block's time for POST /stop (a serve with a timeout blocks, so this is no audio
    // thread's code; the requests for process's routes it leaves to process, at the next block), and gives the changes
    // the page made; or, when it does not listen, why (HTTP_REFUSED: no --web-listen).
    int run(float seconds)
    {
        if (http_port(server) <= 0)
            return http_port(server);
        float block[480];
        int blocks = (int)(seconds * 100.0f);
        for (int b = 0; b < blocks && http_port(server) > 0; ++b)
        {
            process(block, 480);
            serve (server, 10)
            {
                route "POST /stop"                                       // ends the run at once: its reply goes
                {                                                        // out as the host closes the server
                    blocks = 0;
                    reply 204;
                }
            }
        }
        return changes;
    }
};

// fminus remote.fm --run run 600 --web-listen localhost:8080 --web-root page (README.md).
int run(float seconds)
{
    Remote synth;
    synth.init(48000.0f);
    return synth.run(seconds);
}
#endif
