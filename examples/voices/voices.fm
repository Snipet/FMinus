// examples/voices/voices.fm: a small synth in modules (docs/extending.md, recipe 12): eight voices, each a sawtooth
// through a low-pass under a linear envelope. A module is FMinus's class: fields, and methods that see them by name.
// A Voice holds an Osc, a OnePole and an Envelope, and the Synth an array of eight Voices: modules inside modules.
//
// What a player turns is the Synth's parameters (recipe 14): the cutoff, the attack, the release and the gain are
// knobs, values the host sets between calls (or from another thread), which process reads once a call; the sample
// rate is one too, and the harness freezes it, compiling it in. The host (bench.cpp) allocates the Synth itself, as a
// plugin's prepare() would: the program tells it the module's size and alignment (fminus::Program::module), every
// field starts at 0, and setDefaults sets the parameters. It then calls note_on, note_off and process, which runs a
// block of samples and cannot allocate.

// A naive sawtooth, from -1 up to 1 once a period.
module Osc
{
    float phase;   // 0 to 1
    float step;    // the frequency, in periods a sample

    void start(float frequency, float rate) [[clang::nonblocking]]
    {
        phase = 0;
        step = frequency / rate;
    }

    float tick() [[clang::nonblocking]]
    {
        const float out = 2 * phase - 1;
        phase += step;
        if (phase >= 1)
            phase -= 1;
        return out;
    }
};

// A one-pole low-pass, its coefficient k the Synth's to set.
module OnePole
{
    float y;
    float k;

    float tick(float x) [[clang::nonblocking]]
    {
        y += k * (x - y);
        return y;
    }
};

// A linear attack and release: up to 1 while the note is held, then down to 0, a step a sample (the Synth's to set).
module Envelope
{
    float level;
    float up;
    float down;
    bool held;

    float tick() [[clang::nonblocking]]
    {
        level = held ? fminf(1, level + up) : fmaxf(0, level - down);
        return level;
    }
};

module Voice
{
    Osc osc;
    OnePole filter;
    Envelope envelope;

    float tick() [[clang::nonblocking]]
    {
        return envelope.tick() * filter.tick(osc.tick());
    }
};

module Synth
{
    param float cutoff [[fminus::range(20, 20000)]] [[fminus::default(2000)]];    // Hz, every voice's filter
    param float attack [[fminus::range(0.001, 2)]] [[fminus::default(0.005)]];    // seconds
    param float release [[fminus::range(0.001, 5)]] [[fminus::default(0.05)]];    // seconds
    param float gain [[fminus::range(0, 1)]] [[fminus::default(0.125)]];          // the mix's level
    param float rate [[fminus::range(8000, 384000)]] [[fminus::default(48000)]];  // Hz
    Voice voices[8];

    void note_on(int v, float frequency) [[clang::nonblocking]]
    {
        voices[v].osc.start(frequency, rate[0]);
        voices[v].envelope.held = true;
    }

    void note_off(int v) [[clang::nonblocking]]
    {
        voices[v].envelope.held = false;
    }

    // n samples of the eight voices, mixed. The knobs become every voice's coefficients once, where the call starts:
    // a knob is one value a call.
    void process(float* restrict out, int n) [[clang::nonblocking]]
    {
        const float k = 1 - expf(-6.28318531f * cutoff[0] / rate[0]);
        const float up = 1 / (attack[0] * rate[0]);
        const float down = 1 / (release[0] * rate[0]);
        for (int v = 0; v < 8; ++v)
        {
            voices[v].filter.k = k;
            voices[v].envelope.up = up;
            voices[v].envelope.down = down;
        }
        for (int i = 0; i < n; ++i)
        {
            float mix = 0;
            for (int v = 0; v < 8; ++v)
                mix += voices[v].tick();
            out[i] = gain[i] * mix;
        }
    }
};
