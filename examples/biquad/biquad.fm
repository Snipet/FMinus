// examples/biquad/biquad.fm: a biquad low-pass filter whose coefficients are recomputed every sample: the RBJ "Audio EQ
// Cookbook" low-pass, in transposed direct form II. The harness (bench.cpp) runs it over noise with the cutoff swept
// every sample, compares it with a C++ version of the same formulas and times both.
//
// One sample is one call. FMinus has no structs yet, but it has float4, so the filter's three results come back
// together in one vector, and the coefficients, sinf and cosf included, are computed once a sample:
//     (y, s1, s2, 0) = lowpass(x, s1, s2, cutoff, q, rate)
// A float4 crosses the C ABI in a register, so the harness calls it as clang's ext_vector_type. README.md, beside this
// file, suggests the features that shrink this to one call per buffer, in order.
//
// Every constant is written as a float (the f suffix), and the float4s are built with C's literal, (float4){...}, not
// OpenCL C's (float4)(...). So with clang's ext_vector_type for float4 (README.md has the typedef) this file is also
// C with the same meaning, given <math.h> and -ffp-contract=off.

float pi()
{
    return 3.14159265358979323846f;
}

// The cookbook's low-pass coefficients, normalised by a0 = 1 + alpha, as (b0, b1, a1, a2); b2 is b0. Its
// intermediates are w0 = 2 pi f0 / Fs and alpha = sin(w0) / (2 Q).
float4 lowpass_coefficients(float cutoff, float q, float rate)
{
    const float w0 = 2.0f * pi() * cutoff / rate;
    const float c = cosf(w0);
    const float alpha = sinf(w0) / (2.0f * q);
    const float a0 = 1.0f + alpha;
    return (float4){(1.0f - c) / 2.0f / a0, (1.0f - c) / a0, -2.0f * c / a0, (1.0f - alpha) / a0};
}

// One sample of transposed direct form II: the output and the two new states, (y, s1, s2, 0).
float4 lowpass(float x, float s1, float s2, float cutoff, float q, float rate)
{
    const float4 k = lowpass_coefficients(cutoff, q, rate);   // (b0, b1, a1, a2)
    const float y = k.x * x + s1;
    return (float4){y, k.y * x - k.z * y + s2, k.x * x - k.w * y};   // the last lane is 0
}
