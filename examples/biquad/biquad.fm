// examples/biquad/biquad.fm: a biquad low-pass filter whose coefficients are recomputed every sample: the RBJ "Audio EQ
// Cookbook" low-pass, in transposed direct form II. The harness (bench.cpp) runs it over noise with the cutoff swept
// every sample, compares it with a C++ version of the same formulas and times both.
//
// The filter is a module, Biquad: its state, (s1, s2), is two fields, and what a host sets is three parameters
// (docs/extending.md, recipe 14). The harness compiles it with the cutoff a stream, a buffer of one cutoff a sample,
// so the sweep is sample-accurate; q a knob, set once a call; and the sample rate frozen, compiled in as a constant,
// since it changes only when the host starts again. process filters a block a call, and the state carries over, so
// one call for the whole signal and one call a block give the same output.
//
// In the code, every constant that is not a whole number is written as a float (the f suffix), and the float4s are
// built with C's literal, (float4){...}, not OpenCL C's (float4)(...): the functions are C too.

float pi(void)
{
    return 3.14159265358979323846f;
}

// The cookbook's low-pass coefficients, normalised by a0 = 1 + alpha, as (b0, b1, a1, a2); b2 is b0. Its
// intermediates are w0 = 2 pi f0 / Fs and alpha = sin(w0) / (2 Q).
float4 lowpass_coefficients(float cutoff, float q, float rate)
{
    const float w0 = 2.0f * pi() * cutoff / rate;
    const float c = cosf(w0);
    const float alpha = sinf(w0) / (2.0f * q);
    const float a0 = 1.0f + alpha;
    return (float4){(1.0f - c) / 2.0f / a0, (1.0f - c) / a0, -2.0f * c / a0, (1.0f - alpha) / a0};
}

module Biquad
{
    param float cutoff [[fminus::range(20, 20000)]] [[fminus::default(1000)]];   // Hz
    param float q [[fminus::range(0.1, 20)]] [[fminus::default(0.7071)]];
    param float rate [[fminus::range(8000, 384000)]] [[fminus::default(48000)]];   // Hz
    float s1;
    float s2;

    // n samples of transposed direct form II. The state lives in registers through the loop and goes back to its
    // fields once, at the end: nothing else the loop reads or writes can be a field (restrict, and the stream's own
    // alias scope).
    void process(const float* restrict input, float* restrict output, int n) [[clang::nonblocking]]
    {
        for (int i = 0; i < n; ++i)
        {
            const float4 k = lowpass_coefficients(cutoff[i], q[i], rate[i]);   // (b0, b1, a1, a2)
            const float x = input[i];
            const float y = k.x * x + s1;
            s1 = k.y * x - k.z * y + s2;
            s2 = k.x * x - k.w * y;
            output[i] = y;
        }
    }
};
