// The generator reproduces the hand-written module it was designed from: experiments/ex1c.fm's DiodeTone (fminus.md
// §4's example 1, as printed) against Inputs/ex1c-gen.cir's DiodeToneGen, the same netlist in ex1c.fm's configuration
// (N Vt 45.3 mV, no ADAA, omega3 + 1 Newton step at 4x). Both run their step at 192 kHz on a 3 kHz sine for 0.05 s;
// their float formulations agree to about 1e-6, where omega + 1 against omega + 2 differs at about -55 dB.
// RUN: fminus %s -I %S/../../../docs/research/analog-circuits/experiments -I %S/Inputs --run same 4.5 0 | FileCheck %s
// RUN: fminus %s -I %S/../../../docs/research/analog-circuits/experiments -I %S/Inputs --run same 4.5 0.5 | FileCheck %s
// RUN: fminus %s -I %S/../../../docs/research/analog-circuits/experiments -I %S/Inputs --run same 4.5 1 | FileCheck %s
// CHECK: true
#include "ex1c.fm"
#include "ex1c-gen.cir"

// max |a - b| <= 2e-5 max |a| (-94 dB) over 0.05 s at 192 kHz, with the tone pot at `pot`.
bool same(float amp, float pot)
{
    DiodeTone a;
    a.init(48000);   // its step runs at 4 rate
    a.set(pot);
    DiodeToneGen b;
    b.init(48000);
    b.set(pot);
    float worst = 0;
    float top = 0;
    float phase = 0;
    for (int i = 0; i < 9600; ++i)
    {
        const float u = amp * sinf(6.28318531f * phase);
        phase += 3000.0f / 192000.0f;
        phase = phase >= 1 ? phase - 1 : phase;
        const float ya = a.step(u);
        const float yb = b.step(u);
        worst = fmaxf(worst, fabsf(ya - yb));
        top = fmaxf(top, fabsf(ya));
    }
    return worst <= 2e-5f * top;
}
