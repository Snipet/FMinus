#!@FMINUS_LIT_PYTHON@
# bin/fminus-lit: generated by CMake from tests/lit/fminus-lit.py.in. lit, with FMinus's source suite mapped to this
# build tree's site configuration, so a path in the source tree runs as it is:
#     bin/fminus-lit -v ../tests/lit                 (the whole suite)
#     bin/fminus-lit -v ../tests/lit/smoke/x.test    (one test)
import os
import sys

lit_dir = r"@FMINUS_LIT_DIR@"
if lit_dir:
    sys.path.insert(0, lit_dir)

config_map = {
    os.path.normcase(os.path.realpath(r"@CMAKE_CURRENT_SOURCE_DIR@/lit/lit.cfg.py")):
        os.path.normpath(r"@FMINUS_LIT_SITE_CONFIG@"),
}

if __name__ == "__main__":
    from lit.main import main

    main({"build_mode": ".", "config_map": config_map})
