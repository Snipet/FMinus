// A module past 4 GB: its size is 64 bits, as C's size_t, in a copy's memcpy, a declaration's memset and what a
// method's `this` promises (dereferenceable). sizeof of it is an error: FMinus's sizeof is an int.
// RUN: fminus %s -O0 | FileCheck %s
// RUN: not fminus %s -D SIZEOF 2>&1 | FileCheck %s --check-prefix=ERR --implicit-check-not=error:

module Huge
{
    float4 lanes[1073741824];   // 16 GiB
    float last;
    float read() { return last; }
};

void copy(Huge* to, const Huge* from)
{
    *to = *from;
}

float local()
{
    Huge h;
    return h.last;
}

#ifdef SIZEOF
int size() { return sizeof(Huge); }
#endif

// CHECK-LABEL: define float @"Huge::read"(ptr nonnull align 16 dereferenceable(17179869200) %this)
// CHECK-LABEL: define void @copy(
// CHECK:         call void @llvm.memcpy.p0.p0.i64(ptr align 16 %{{.*}}, ptr align 16 %{{.*}}, i64 17179869200,
// CHECK-LABEL: define float @local()
// CHECK:         call void @llvm.memset.p0.i64(ptr align 16 %h, i8 0, i64 17179869200, i1 false)

// ERR: large-modules.fm:25:21: error: 'Huge' is too large for sizeof: 17179869200 bytes, and FMinus's sizeof is
