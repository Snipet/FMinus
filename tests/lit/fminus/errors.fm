// Errors carry their file, line and column; one run reports every semantic error, in clang's words.
// RUN: not fminus %s 2>&1 | FileCheck %s

float f(float x)
{
    const float y = x + z;
    y = nope(y);
    return y;
}

// CHECK: errors.fm:6:25: error: use of undeclared identifier 'z'
// CHECK: errors.fm:7:7: error: cannot assign to variable 'y' with const-qualified type 'const float'
// CHECK: errors.fm:7:9: error: call to undeclared function 'nope'
