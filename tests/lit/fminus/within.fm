// `within (milliseconds) { ... }` (src/ir/Within.cpp; docs/web.md, "within"): the milliseconds computed once, the
// calling thread's deadline scope begun under the program's web context, and ended at every way out of the block (its
// end, return, break, continue), after the block's own deferred statements, as a defer's statement runs there; never
// when its begin failed (no memory: no scope open). The library's two functions are declared with what they do. With
// the loop budget or bounds checks, a function that begins a scope abandons its thread's scopes on each of the passes'
// ways out (opt/EarlyReturn.h), and a function that begins none is as it was. With no --web-allow nothing is reachable:
// the requests are refused at once, and the block has nothing to wait for. No test here makes a request:
// tests/unit/WithinTest.cpp fetches from a loopback server of its own.
// REQUIRES: web
// RUN: fminus %s -O0 | FileCheck %s
// RUN: fminus %s -O0 --loop-budget 1000 | FileCheck %s --check-prefix=BUDGET
// RUN: fminus %s -O2 --bounds-check | FileCheck %s --check-prefix=BOUNDS
// RUN: fminus %s --emit ast | FileCheck %s --check-prefix=AST
// RUN: fminus %s --run main 3 | FileCheck %s --check-prefix=RESULT

int spin(int n)
{
    int s = 0;
    for (int i = 0; i < n; ++i)
        s += i;
    return s;
}

int fetch(int k, int ms)
{
    http_response r;
    int seen = 0;
    within (ms + 1)
    {
        r = http_get("http://127.0.0.1:1/packs/%d.json", k);
        defer seen = http_status(r);
        if (k > 2)
            return seen;
        seen = spin(k);
    }
    return http_status(r) + seen;
}

// CHECK-LABEL: define i32 @fetch(
// CHECK: %within.slot = alloca i1
// CHECK: %[[MS:.+]] = add nsw i32 %{{.+}}, 1
// CHECK: %[[CONTEXT:.+]] = load ptr, ptr @fminus_web_context, align 8
// CHECK-NEXT: %within.begun = call i32 @fminus_web_http_within_begin(ptr %[[CONTEXT]], i32 %[[MS]])
// CHECK-NEXT: %within.open = icmp eq i32 %within.begun, 0
// CHECK-NEXT: store i1 %within.open, ptr %within.slot, align 1, !tbaa
// The return: its value, then the block's defer, then the scope's end, then the ret.
// CHECK: if.then:
// CHECK: %[[VALUE:.+]] = load i32, ptr %seen
// CHECK: call i32 @fminus_web_http_status(
// CHECK: %within.opened = load i1, ptr %within.slot, align 1, !tbaa
// CHECK-NEXT: br i1 %within.opened, label %within.end, label %within.done
// The block's end: the same, once.
// CHECK: if.end:
// CHECK: call i32 @spin(
// CHECK: call i32 @fminus_web_http_status(
// CHECK: %within.opened{{[0-9]+}} = load i1, ptr %within.slot
// CHECK: within.end:
// CHECK-NEXT: %[[AT:.+]] = load ptr, ptr @fminus_web_context, align 8
// CHECK-NEXT: %within.ended = call i32 @fminus_web_http_within_end(ptr %[[AT]])
// CHECK-NEXT: br label %within.done
// CHECK: within.done:
// CHECK-NEXT: ret i32 %[[VALUE]]

// break and continue leave a loop's block through its scope's end too, each once.
int loop(int n)
{
    int k = 0;
    for (int i = 0; i < n; ++i)
    {
        within (10)
        {
            if (i == 1)
                continue;
            if (i == 3)
                break;
            k += i;
        }
    }
    return k;
}

// CHECK-LABEL: define i32 @loop(
// CHECK-COUNT-3: call i32 @fminus_web_http_within_end(
// CHECK-NOT: call i32 @fminus_web_http_within_end(
// CHECK: ret i32

// No request, no within: a function that begins no scope.
int plain(int n)
{
    return spin(n) + 1;
}

float main(float x)
{
    return (float)(fetch((int)x, 100) + loop((int)x));
}

// CHECK: declare i32 @fminus_web_http_within_begin(ptr captures(none), i32) #[[BEGIN:[0-9]+]]
// CHECK: declare i32 @fminus_web_http_within_end(ptr captures(none)) #[[END:[0-9]+]]
// CHECK: attributes #[[BEGIN]] = { nounwind willreturn memory(argmem: readwrite, inaccessiblemem: readwrite, errnomem: write) }
// CHECK: attributes #[[END]] = { nounwind memory(argmem: readwrite, inaccessiblemem: readwrite) }

// With the loop budget: fetch may stop (it calls spin, which counts), and abandons its thread's scopes on its way out;
// spin and plain begin none, and return as they did.
// BUDGET-LABEL: define i32 @spin(
// BUDGET: budget.stop:
// BUDGET-NOT: within_abandon
// BUDGET: ret i32 0
// BUDGET-LABEL: define i32 @fetch(
// BUDGET: budget.unwind:
// BUDGET-NEXT: %[[CONTEXT:.+]] = load ptr, ptr @fminus_web_context, align 8
// BUDGET-NEXT: %within.abandoned = call i32 @fminus_web_http_within_abandon(ptr %[[CONTEXT]])
// BUDGET-NEXT: ret i32 0
// BUDGET-LABEL: define i32 @loop(
// BUDGET: budget.stop:
// BUDGET: call i32 @fminus_web_http_within_abandon(
// BUDGET-NEXT: ret i32 0
// BUDGET-LABEL: define i32 @plain(
// BUDGET: budget.unwind:
// BUDGET-NEXT: ret i32 0
// BUDGET: declare i32 @fminus_web_http_within_abandon(ptr captures(none)) #[[ABANDON:[0-9]+]]
// BUDGET: attributes #[[ABANDON]] = { nofree nounwind willreturn memory(argmem: readwrite, inaccessiblemem: readwrite) }

// With bounds checks and none failing: nothing of the checks, and no abandon, at -O2.
// BOUNDS-NOT: within_abandon

// AST-LABEL: (function int fetch ((int k) (int ms))
// AST: (within (+ ms 1)
// AST-NEXT: (block
// AST-NEXT: (= r (call http_get "http://127.0.0.1:1/packs/%d.json" k))
// AST-NEXT: (defer

// No network: each request refused at once, and the block has nothing to wait for. fetch(3, 100) returns what seen held
// when its return was reached, 0, before the defer set it to HTTP_REFUSED; loop(3) is 0 + 2.
// RESULT: 2
