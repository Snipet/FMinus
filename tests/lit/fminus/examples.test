# The examples run, and give what their comments say (examples/*/*.fm). main.fm runs note and comparison; the biquad,
# delay, saturator, meter and ensemble have harnesses of their own (ctest's example.biquad, ...).
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --run main 0.25 1000 | FileCheck %s --check-prefix=SAW
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --run main 0.25 10000 | FileCheck %s --check-prefix=SAW2
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --run square 0.25 1000 48000 | FileCheck %s --check-prefix=SQ
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --run wave 1 0.25 1000 | FileCheck %s --check-prefix=SQ
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --run wave 2 0.25 1000 | FileCheck %s --check-prefix=SILENCE
# RUN: fminus %S/../../../examples/waveforms/waveforms.fm --emit exe -o %t.waveforms
# RUN: %t.waveforms 0.75 1000 | FileCheck %s --check-prefix=SAWNEG
# RUN: fminus %S/../../../examples/chord/chord.fm --run main 60 1 | FileCheck %s --check-prefix=CHORD
# RUN: fminus %S/../../../examples/chord/chord.fm --run span 60 | FileCheck %s --check-prefix=SPAN
# RUN: fminus %S/../../../examples/chord/chord.fm -O2 | FileCheck %s --check-prefix=CHORDIR
# RUN: fminus %S/../../../examples/unison/unison.fm --run main 0.01 7 | FileCheck %s --check-prefix=MIX
# RUN: fminus %S/../../../examples/unison/unison.fm --poly-lanes 16 --run main 0.01 7 | FileCheck %s --check-prefix=MIX
# RUN: fminus %S/../../../examples/unison/unison.fm --poly-lanes 16 --run lanes | FileCheck %s --check-prefix=LANES16
# RUN: fminus %S/../../../examples/noise/noise.fm --run main 48000 | FileCheck %s --check-prefix=NOISE
# RUN: fminus %S/../../../examples/noise/noise.fm --run main 48000 -O0 --math libm | FileCheck %s --check-prefix=NOISE
# RUN: fminus %S/../../../examples/noise/noise.fm --run apart 48000 | FileCheck %s --check-prefix=APART
# RUN: fminus %S/../../../examples/trigger/trigger.fm --run notes 10 | FileCheck %s --check-prefix=NOTES
# RUN: fminus %S/../../../examples/trigger/trigger.fm --run held 10 | FileCheck %s --check-prefix=HELD

# 23 harmonics below 24 kHz approach the ideal 0.5; at 10 kHz only two fit, and the sum is exactly 2/pi. The last
# digits are the math functions': 0.4867599 with FMinus's kernels (the default math mode) and with libm's, 0.48676 with
# Apple's vector functions (the fast mode's).
# SAW: 0.4867{{[0-9]*}}
# SAW2: 0.63661975
# SQ: 0.97351{{[0-9]*}}
# SILENCE: {{^}}0{{$}}
# SAWNEG: -0.4867{{[0-9]*}}

# G4, and the span of the inversion: 2^(8/12). One vector expf for the four notes: FMinus's exp kernel on four lanes,
# inline (the default math mode), with no call.
# CHORD: 391.995{{[0-9]*}}
# SPAN: 1.5874{{[0-9]*}}
# CHORDIR-LABEL: define <4 x float> @frequencies(
# CHORDIR-NOT:   call {{.*}}@fminus
# CHORDIR:       call <4 x float> @llvm.fma.v4f32(<4 x float>
# CHORDIR-NOT:   call {{.*}}@fminus
# CHORDIR:       ret <4 x float>

# The mean of 7 detuned saws; the last digits depend on the width.
# MIX: -0.799592{{[0-9]*}}
# LANES16: 16

# A second of white noise at 48 kHz: its RMS, near 1/sqrt(3) = 0.57735, the same bits at -O0 and in libm's math mode
# (randf computes on integers, exactly). Two voices' sources, from two seeds, barely correlate.
# NOISE: 0.5765617
# APART: -0.0015290721

# Ten beats of a gate, fed a block at a time, its edges anywhere in a block: one note a beat, which `when` finds across
# the blocks; an if on the gate runs on every one of the 900 samples a beat holds it high.
# NOTES: {{^}}10{{$}}
# HELD: {{^}}9000{{$}}
