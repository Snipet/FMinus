// The JSON parser's builtins (runtime/Json.cpp): json_parse and json_free, which allocate, and the reads, wait-free,
// which a nonblocking function calls. Each path is prepared when the program is compiled: a private constant of its
// steps, a count of pieces and then (offset, length) for a key's bytes or (place, -1) for a %d, with the bytes after
// them, so the runtime never reads a path's text; json_choice's literals are another such table. The runtime's
// functions are declared with what they do (recipe 19). A program parses a document and reads it through the JIT and
// as an executable, which links libfminus_runtime.a, the parser in it.
// REQUIRES: json
// RUN: fminus %s -O0 | FileCheck %s
// RUN: fminus %s --run main 2 | FileCheck %s --check-prefix=RESULT
// RUN: fminus %s --emit exe -o %t.json
// RUN: %t.json 2 | FileCheck %s --check-prefix=RESULT

float read(const void* doc, int k) [[clang::nonblocking]]
{
    float row[2];
    const int n = json_floats(doc, "/a", row, 2);
    float packed[2];
    const int m = json_base64_floats(doc, "/b64", packed, 2);
    return json_float(doc, "/a/%d", k, -1.0f) + json_choice(doc, "/w", "sine", "saw") + 10 * json_count(doc, "/a")
           + 100 * json_int(doc, "/n", 0) + row[0] + row[1] + n + packed[0] + packed[1] + m;
}

// x times nothing: the document {"a": [1.5, 2.25], "w": "saw", "n": 7, "b64": "AACAPwAAAEA="}, its 61 bytes in
// little-endian ints, read at k = x - 1, and the same bytes but the last, which are no JSON: a null document, read.
float main(float x)
{
    int text[16] = {576791163, 828055610, 539768110, 892481074, 572533853, 540680823, 2002875170, 572533794,
                    540680814, 572533815, 573847138, 1092755514, 1346454337, 1094795639, 574439749, 125};
    void* doc = json_parse(text, 61);
    const float r = read(doc, (int)x - 1);
    json_free(doc);
    void* broken = json_parse(text, 60);
    const float half = json_count(broken, "") + json_float(broken, "/n", 0.5f);
    json_free(broken);
    return r + half;
}

// "/a": one step of one piece, the byte at 0, 1 long. "/a/%d": then a step whose one piece is the first int. "": none.
// CHECK: @.path = private unnamed_addr constant { i32, i32, [3 x i32], [1 x i8] } { i32 3, i32 1, [3 x i32] [i32 1, i32 0, i32 1], [1 x i8] c"a" }, align 4
// CHECK: @.path.2 = private unnamed_addr constant { i32, i32, [6 x i32], [1 x i8] } { i32 6, i32 1, [6 x i32] [i32 1, i32 0, i32 1, i32 1, i32 0, i32 -1], [1 x i8] c"a" }, align 4
// CHECK: @.choices = private unnamed_addr constant { i32, i32, [2 x i32], [7 x i8] } { i32 2, i32 7, [2 x i32] [i32 4, i32 3], [7 x i8] c"sinesaw" }, align 4
// CHECK: @.path.6 = private unnamed_addr constant { i32, i32, [0 x i32], [0 x i8] } zeroinitializer, align 4
// CHECK-LABEL: define float @read(
// CHECK:         %format.ints = alloca [1 x i32]
// CHECK:         %json_floats = call i32 @fminus_rt_json_floats(ptr {{%.*}}, ptr @.path, ptr null, i32 0, ptr {{%.*}}, i32 2)
// CHECK:         %json_base64_floats = call i32 @fminus_rt_json_base64_floats(ptr {{%.*}}, ptr @.path.1, ptr null, i32 0, ptr {{%.*}}, i32 2)
// CHECK:         %json_float = call float @fminus_rt_json_float(ptr {{%.*}}, ptr @.path.2, ptr %format.ints, i32 1, float -1.000000e+00)
// CHECK:         %json_choice = call i32 @fminus_rt_json_choice(ptr {{%.*}}, ptr @.path.3, ptr null, i32 0, ptr @.choices)
// CHECK:         %json_count = call i32 @fminus_rt_json_count(ptr {{%.*}}, ptr @.path.4, ptr null, i32 0)
// CHECK:         %json_int = call i32 @fminus_rt_json_int(ptr {{%.*}}, ptr @.path.5, ptr null, i32 0, i32 0)
// CHECK-LABEL: define float @main(
// CHECK:         %json_parse = call ptr @fminus_rt_json_parse(ptr {{%.*}}, i32 61)
// CHECK:         call void @fminus_rt_json_free(ptr {{%.*}})
// CHECK: declare i32 @fminus_rt_json_floats(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, ptr writeonly captures(none), i32) [[INTO:#[0-9]+]]
// CHECK: declare i32 @fminus_rt_json_base64_floats(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, ptr writeonly captures(none), i32) [[INTO]]
// CHECK: declare float @fminus_rt_json_float(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, float) [[READ:#[0-9]+]]
// CHECK: declare i32 @fminus_rt_json_choice(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, ptr readonly captures(none)) [[READ]]
// CHECK: declare i32 @fminus_rt_json_count(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32) [[READ]]
// CHECK: declare i32 @fminus_rt_json_int(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, i32) [[READ]]
// CHECK: declare noalias noundef ptr @fminus_rt_json_parse(ptr readonly captures(none), i32) [[PARSE:#[0-9]+]]
// CHECK: declare void @fminus_rt_json_free(ptr captures(none)) [[FREE:#[0-9]+]]
// CHECK: attributes [[INTO]] = { nofree nosync nounwind willreturn memory(argmem: readwrite, inaccessiblemem: read) }
// CHECK: attributes [[READ]] = { nofree nosync nounwind willreturn memory(argmem: read, inaccessiblemem: read) }
// CHECK: attributes [[PARSE]] = { nounwind willreturn memory(argmem: read, inaccessiblemem: readwrite, errnomem: write) }
// CHECK: attributes [[FREE]] = { nounwind willreturn memory(argmem: readwrite, inaccessiblemem: readwrite) }

// read: 2.25 + 1 (saw) + 10 * 2 + 100 * 7 + (1.5 + 2.25) + 2 + (1 + 2) + 2 = 734; the null document: 0 + 0.5.
// RESULT: {{^}}734.5{{$}}
