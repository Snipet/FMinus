// switch, as clang -O0 lowers C's: the value goes to LLVM's switch, one case a label, sw.bb for each case and
// sw.default for default, which fall into each other, and sw.epilog after the body, where break goes; without a default
// label the switch's default is sw.epilog. A jump past a declaration of the body goes through sw.zero, which zeroes it.
// A case's value is folded where it is written: 2 + 3 * 4 is 14. At -O2, a switch of constants becomes a table (LLVM's
// switch-to-lookup), or a select, the passed declaration's zero folded in.
// RUN: fminus %s -O0 | FileCheck %s
// RUN: fminus %s -O2 | FileCheck %s --check-prefix=OPT
// RUN: fminus %s --emit ast | FileCheck %s --check-prefix=AST
// RUN: fminus %s --run gain 2 | FileCheck %s --check-prefix=RESULT

int pick(int x)
{
    int r = 0;
    switch (x)
    {
    case 0:
        r = 10;
        break;
    case 1:
    case 2 + 3 * 4:
        r = 20;
    case -3:
        r += 1;
        break;
    default:
        r = -1;
    }
    return r;
}

int none(bool b)
{
    switch (b) { }
    switch (b) { case true: return 1; }
    return 0;
}

float passed(int x)
{
    switch (x)
    {
    case 0:
        float t = 2;
        return t;
    case 1:
        return t;
    }
    return 0;
}

// --run passes and prints floats.
float gain(float x)
{
    switch ((int)x)
    {
    case 1: return 0.5f;
    case 2: return 0.25f;
    default: return 1;
    }
}

// CHECK-LABEL: define i32 @pick(i32 %x)
// CHECK:         switch i32 %{{.*}}, label %sw.default [
// CHECK-NEXT:      i32 0, label %sw.bb
// CHECK-NEXT:      i32 1, label %[[ONE:sw.bb[0-9]*]]
// CHECK-NEXT:      i32 14, label %[[FOURTEEN:sw.bb[0-9]*]]
// CHECK-NEXT:      i32 -3, label %[[MINUS:sw.bb[0-9]*]]
// CHECK-NEXT:    ]
// CHECK:       sw.bb:
// CHECK:         store i32 10
// CHECK-NEXT:    br label %sw.epilog
// CHECK:       [[ONE]]:
// CHECK-NEXT:    br label %[[FOURTEEN]]
// CHECK:       [[FOURTEEN]]:
// CHECK:         store i32 20
// CHECK-NEXT:    br label %[[MINUS]]
// CHECK:       [[MINUS]]:
// CHECK:         add nsw i32 %{{.*}}, 1
// CHECK:         br label %sw.epilog
// CHECK:       sw.default:
// CHECK:         store i32 -1
// CHECK-NEXT:    br label %sw.epilog
// CHECK:       sw.epilog:
// CHECK-NEXT:    load i32, ptr %r

// CHECK-LABEL: define i32 @none(i1 zeroext %b)
// CHECK:         %conv = zext i1 %{{.*}} to i32
// CHECK-NEXT:    switch i32 %conv, label %sw.epilog [
// CHECK-NEXT:    ]
// CHECK:         switch i32 %{{.*}}, label %[[END:sw.epilog[0-9]*]] [
// CHECK-NEXT:      i32 1, label %sw.bb
// CHECK-NEXT:    ]

// CHECK-LABEL: define float @passed(i32 %x)
// CHECK:         switch i32 %{{.*}}, label %sw.epilog [
// CHECK-NEXT:      i32 0, label %sw.bb
// CHECK-NEXT:      i32 1, label %sw.zero
// CHECK-NEXT:    ]
// CHECK:       sw.bb:
// CHECK-NEXT:    store float 2.000000e+00, ptr %t
// CHECK:       [[CASE1:sw.bb[0-9]+]]:
// CHECK:         load float, ptr %t
// CHECK:       sw.zero:
// CHECK-NEXT:    store float 0.000000e+00, ptr %t
// CHECK-NEXT:    br label %[[CASE1]]
// CHECK:       sw.epilog:

// OPT-LABEL: define {{.*}}i32 @pick(i32 %x)
// OPT:         @switch.table.pick
// OPT-LABEL: define {{.*}}float @passed(i32 %x)
// OPT:         select i1 %{{.*}}, float 2.000000e+00, float 0.000000e+00

// AST:      (function int pick ((int x))
// AST:        (switch x
// AST-NEXT:     (block
// AST-NEXT:       (case 0)
// AST-NEXT:       (= r 10)
// AST-NEXT:       (break)
// AST-NEXT:       (case 1)
// AST-NEXT:       (case (+ 2 (* 3 4)))
// AST-NEXT:       (= r 20)
// AST-NEXT:       (case (- 3))
// AST-NEXT:       (+= r 1)
// AST-NEXT:       (break)
// AST-NEXT:       (default)
// AST-NEXT:       (= r (- 1))))

// RESULT: 0.25
