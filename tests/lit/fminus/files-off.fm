// In a build without the file interface (FMINUS_FILES=OFF), each file_ builtin and each status code's name is still a
// name FMinus knows: its use is an error that names the option, not an undeclared function or identifier;
// __FMINUS_FILES__ and __FMINUS_FILES_WRITE__ are not defined; and the driver's file options say the build has no file
// interface.
// UNSUPPORTED: files
// RUN: not fminus %s 2>&1 | FileCheck %s --implicit-check-not=error:
// RUN: not fminus %s --run load --files-read kit=%S 2>&1 | FileCheck %s --check-prefix=READ
// RUN: not fminus %s --run load --files-write user=%S 2>&1 | FileCheck %s --check-prefix=WRITE
// RUN: not fminus %s --run load --files-anywhere 2>&1 | FileCheck %s --check-prefix=ANYWHERE
// RUN: not fminus %s --run load --files-deny %S 2>&1 | FileCheck %s --check-prefix=DENY

#if defined(__FMINUS_FILES__) || defined(__FMINUS_FILES_WRITE__)
#error __FMINUS_FILES__ or __FMINUS_FILES_WRITE__ is defined
#endif

int load(const void* data)
{
    void* f = file_read("kit/%d.f32", 1);
    void* l = file_list("kit/*.f32");
    int s = file_status(f) + file_size(f) + file_count(l) + file_write("user/a.f32", data, 4);
    const void* d = file_data(f);
    void* g = file_read_nth(l, 0);
    file_close(g);
    return s + file_append("user/log.txt", data, 4) + FILE_REFUSED;
}

// A file's name with holes, and a listing's names: the same error, once a call.
int named(string name, int k, const void* data)
{
    file_content f = file_read("kit/{name}/{k}.f32");
    file_listing l = file_list("kit/{name}/*.f32");
    return string_size(file_name(l, k)) + file_write("user/{name}.f32", data, 4);
}

// A JSON literal to a file: the file interface's error, once a call, whatever the JSON writer.
int saved(int n) { return file_write("user/n.json", json { "n": n }) + file_append("user/n.jsonl", json (n)); }

