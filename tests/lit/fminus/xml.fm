// The XML parser's builtins (runtime/Xml.cpp), made as the JSON parser's are (json.fm): xml_parse and xml_free, which
// allocate, and the reads, wait-free, which a nonblocking function calls. Each path is prepared when the program is
// compiled: a private constant of its steps, each a kind (0 an element, 1 with an index, 2 with an int's index, 3 an
// attribute), its name's pieces ((offset, length) of its bytes, or (place, -1) for a %d), and its index, with the bytes
// after them, so the runtime never reads a path's text; xml_choice's literals are another such table. The runtime's
// functions are declared with what they do (recipe 19). A program parses a document and reads it through the JIT and
// as an executable, which links libfminus_runtime.a, the parser in it.
// REQUIRES: xml
// RUN: fminus %s -O0 | FileCheck %s
// RUN: fminus %s --run main 2 | FileCheck %s --check-prefix=RESULT
// RUN: fminus %s --emit exe -o %t.xml
// RUN: %t.xml 2 | FileCheck %s --check-prefix=RESULT

float read(const void* doc, int k) [[clang::nonblocking]]
{
    float row[2];
    const int n = xml_floats(doc, "/p/t", row, 2);
    return xml_float(doc, "/p/a[%d]", k, -1.0f) + xml_choice(doc, "/p/w", "sine", "saw") + 10 * xml_count(doc, "/p/a")
           + 100 * xml_int(doc, "/p/@n", 0) + row[0] + row[1] + n + 1000 * xml_bool(doc, "/p/@s", false);
}

// x times nothing: the document <p n="7" s="1"><a>1.5</a><a>2.25</a><w>saw</w><t>1.5, 2.25</t></p>, its 66 bytes in
// little-endian ints, read at k = x - 1 (the second <a>: indices count from 0), and the same bytes but the last, which
// are no XML: a null document, read.
float main(float x)
{
    int text[17] = {1847619644, 574038589, 574452512, 1010704945, 774979169, 1630485557, 1046559806, 892481074,
                    1046556476, 1933473596, 792491873, 1950105207, 892219710, 775036972, 792474930, 792477300, 15984};
    void* doc = xml_parse(text, 66);
    const float r = read(doc, (int)x - 1);
    xml_free(doc);
    void* broken = xml_parse(text, 65);
    const float half = xml_count(broken, "/p") + xml_float(broken, "/p/@n", 0.5f);
    xml_free(broken);
    return r + half;
}

// "/p/t": two element steps of one piece each, "p" at 0 and "t" at 1. "/p/a[%d]": then a step whose index is the
// first int. "/p/@n": a last step that is an attribute.
// CHECK: @.xmlpath = private unnamed_addr constant { i32, i32, [8 x i32], [2 x i8] } { i32 8, i32 2, [8 x i32] [i32 0, i32 1, i32 0, i32 1, i32 0, i32 1, i32 1, i32 1], [2 x i8] c"pt" }, align 4
// CHECK: @.xmlpath.1 = private unnamed_addr constant { i32, i32, [9 x i32], [2 x i8] } { i32 9, i32 2, [9 x i32] [i32 0, i32 1, i32 0, i32 1, i32 2, i32 1, i32 1, i32 1, i32 0], [2 x i8] c"pa" }, align 4
// CHECK: @.choices = private unnamed_addr constant { i32, i32, [2 x i32], [7 x i8] } { i32 2, i32 7, [2 x i32] [i32 4, i32 3], [7 x i8] c"sinesaw" }, align 4
// CHECK: @.xmlpath.4 = private unnamed_addr constant { i32, i32, [8 x i32], [2 x i8] } { i32 8, i32 2, [8 x i32] [i32 0, i32 1, i32 0, i32 1, i32 3, i32 1, i32 1, i32 1], [2 x i8] c"pn" }, align 4
// CHECK-LABEL: define float @read(
// CHECK:         %format.ints = alloca [1 x i32]
// CHECK:         %xml_floats = call i32 @fminus_rt_xml_floats(ptr {{%.*}}, ptr @.xmlpath, ptr null, i32 0, ptr {{%.*}}, i32 2)
// CHECK:         %xml_float = call float @fminus_rt_xml_float(ptr {{%.*}}, ptr @.xmlpath.1, ptr %format.ints, i32 1, float -1.000000e+00)
// CHECK:         %xml_choice = call i32 @fminus_rt_xml_choice(ptr {{%.*}}, ptr @.xmlpath.2, ptr null, i32 0, ptr @.choices)
// CHECK:         %xml_count = call i32 @fminus_rt_xml_count(ptr {{%.*}}, ptr @.xmlpath.3, ptr null, i32 0)
// CHECK:         %xml_int = call i32 @fminus_rt_xml_int(ptr {{%.*}}, ptr @.xmlpath.4, ptr null, i32 0, i32 0)
// CHECK:         %xml_bool = call i32 @fminus_rt_xml_bool(ptr {{%.*}}, ptr @.xmlpath.5, ptr null, i32 0, i32 0)
// CHECK-LABEL: define float @main(
// CHECK:         %xml_parse = call ptr @fminus_rt_xml_parse(ptr {{%.*}}, i32 66)
// CHECK:         call void @fminus_rt_xml_free(ptr {{%.*}})
// CHECK: declare i32 @fminus_rt_xml_floats(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, ptr writeonly captures(none), i32) [[INTO:#[0-9]+]]
// CHECK: declare float @fminus_rt_xml_float(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, float) [[READ:#[0-9]+]]
// CHECK: declare i32 @fminus_rt_xml_choice(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, ptr readonly captures(none)) [[READ]]
// CHECK: declare i32 @fminus_rt_xml_count(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32) [[READ]]
// CHECK: declare i32 @fminus_rt_xml_int(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, i32) [[READ]]
// CHECK: declare i32 @fminus_rt_xml_bool(ptr readonly captures(none), ptr readonly captures(none), ptr readonly captures(none), i32, i32) [[READ]]
// CHECK: declare noalias noundef ptr @fminus_rt_xml_parse(ptr readonly captures(none), i32) [[PARSE:#[0-9]+]]
// CHECK: declare void @fminus_rt_xml_free(ptr captures(none)) [[FREE:#[0-9]+]]
// CHECK: attributes [[INTO]] = { nofree nosync nounwind willreturn memory(argmem: readwrite, inaccessiblemem: read) }
// CHECK: attributes [[READ]] = { nofree nosync nounwind willreturn memory(argmem: read, inaccessiblemem: read) }
// CHECK: attributes [[PARSE]] = { nounwind willreturn memory(argmem: read, inaccessiblemem: readwrite, errnomem: write) }
// CHECK: attributes [[FREE]] = { nounwind willreturn memory(argmem: readwrite, inaccessiblemem: readwrite) }

// read: 2.25 + 1 (saw) + 10 * 2 + 100 * 7 + (1.5 + 2.25) + 2 + 1000 * 1 = 1729; the null document: 0 + 0.5.
// RESULT: {{^}}1729.5{{$}}
