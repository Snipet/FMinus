// A route's string parameters, and a request's text (src/ir/Serve.cpp, Calls.cpp; docs/web.md): a hole that is a
// whole segment, a %s of the route table, filled by fminus_web_http_text with its place; a query's field by
// fminus_web_http_query_text, its bytes and their count, or the parameter's default string, or the 400; and
// http_header, http_path and http_query_string, each the library's pointer and the count it writes into an int of the
// frame, the last one's fallback chosen when the pointer is null. The library's functions are declared as reading the
// request (and writing that int): not readonly, since the I/O thread writes the slot after the reply. A string in a
// JSON literal is the writer's shape 5, its pointer and its length in two slots; a %s in a reply's format makes the
// call fminus_web_http_reply_text_s, the strings in two arrays after the values. Run, a program
// asks its own server for a preset by name, and answers with the name, a header and the path: nothing binds anything
// but 127.0.0.1, or connects anywhere else.
// REQUIRES: web-server, json
// RUN: fminus %s -O0 | FileCheck %s
// RUN: fminus %s --emit ast | FileCheck %s --check-prefix=AST
// RUN: fminus %s --run main 3 --web-listen 127.0.0.1:0 --web-allow 'http://127.0.0.1:*/presets/*' | FileCheck %s --check-prefix=SERVED

int main(int k)
{
    http_server server = http_listen();
    const int port = http_port(server);
    if (port <= 0)
        return port;
    const string name = "warm-pad";
    http_response c = http_get("http://127.0.0.1:{port}/presets/{name}?mode=size");
    int got = 0;
    serve (server, 5000)
    {
        route "GET /presets/{preset}" (string preset, string mode [[fminus::default("full")]], http_request q)
        {
            const string agent = http_header(q, "host");
            got = string_size(preset) * 10000 + string_size(http_path(q)) * 100
                  + string_size(http_query_string(q, "none", "fallback")) + (mode == "size" ? 1000000 : 0)
                  + (string_starts(agent, "127.0.0.1:") ? 10000000 : 0);
            reply 204;
        }
    }
    const int status = http_wait(c, 5000);
    http_close(c);
    return status == 204 ? got : status;
}

void more(http_server server)
{
    serve (server)
    {
        route "GET /json/{n}" (string n) { reply 200, json { "n": n, "lit": "x" }; }
        route "GET /text/{n}" (string n, int k) { reply 200, "text/plain", "%s %d %s", n, k, "lit"; }
    }
}

// CHECK: @.json = private unnamed_addr constant { i32, i32, [15 x i32], [13 x i8] } { i32 15, i32 13, [15 x i32] [i32 0, i32 0, i32 5, i32 1, i32 0, i32 5, i32 0, i32 5, i32 7, i32 1, i32 2, i32 5, i32 0, i32 12, i32 1], [13 x i8] c"{\22n\22:,\22lit\22:}" }, align 4
// CHECK: @.route{{.*}} = private unnamed_addr constant [15 x i8] c"GET /presets/%s", align 1
// CHECK-LABEL: define i32 @main(
// CHECK:         %preset.text = call ptr @fminus_web_http_text(ptr %{{.*}}, i32 0, ptr %preset.length)
// CHECK-NEXT:    %preset.size = load i32, ptr %preset.length, align 4, !tbaa
// CHECK:         %mode.text = call ptr @fminus_web_http_query_text(ptr %{{.*}}, ptr @.str{{.*}}, i32 4, ptr %mode.length)
// CHECK-NEXT:    %mode.missing = icmp eq ptr %mode.text, null
// CHECK:       param.missing:
// CHECK:         store ptr @.str{{.*}}, ptr %{{.*}}, align 8, !tbaa
// CHECK:         store i32 4, ptr %{{.*}}, align 4, !tbaa
// CHECK:         %http_header.data = call ptr @fminus_web_http_header(ptr %{{.*}}, ptr @.str{{.*}}, i32 4, ptr %http_header.length)
// CHECK:         %http_path.data = call ptr @fminus_web_http_path(ptr %{{.*}}, ptr %http_path.length)
// CHECK:         %http_query_string.data = call ptr @fminus_web_http_query_text(ptr %{{.*}}, ptr @.str{{.*}}, i32 4, ptr %http_query_string.length)
// CHECK-NEXT:    %http_query_string.size = load i32, ptr %http_query_string.length, align 4, !tbaa
// CHECK-NEXT:    %http_query_string.none = icmp eq ptr %http_query_string.data, null
// CHECK-NEXT:    %{{[0-9]+}} = select i1 %http_query_string.none, ptr @.str{{.*}}, ptr %http_query_string.data
// CHECK-NEXT:    %{{[0-9]+}} = select i1 %http_query_string.none, i32 8, i32 %http_query_string.size
// CHECK-LABEL: define void @more(
// CHECK:         %{{[0-9]+}} = getelementptr inbounds i8, ptr %json.values, i32 0
// CHECK-NEXT:    %{{[0-9]+}} = extractvalue { ptr, i32 } %{{.*}}, 0
// CHECK-NEXT:    store ptr %{{.*}}, ptr %{{[0-9]+}}, align 8, !tbaa
// CHECK-NEXT:    %{{[0-9]+}} = extractvalue { ptr, i32 } %{{.*}}, 1
// CHECK-NEXT:    %{{[0-9]+}} = getelementptr inbounds i8, ptr %json.values, i32 8
// CHECK-NEXT:    store i32 %{{.*}}, ptr %{{[0-9]+}}, align 4, !tbaa
// CHECK-NEXT:    %{{[0-9]+}} = getelementptr inbounds i8, ptr %json.values, i32 16
// CHECK-NEXT:    store ptr @.str{{.*}}, ptr %{{[0-9]+}}, align 8, !tbaa
// CHECK-NEXT:    %{{[0-9]+}} = getelementptr inbounds i8, ptr %json.values, i32 24
// CHECK-NEXT:    store i32 1, ptr %{{[0-9]+}}, align 4, !tbaa
// CHECK:         %json.bytes = call i32 @fminus_rt_json_write(ptr %reply.buffer, i32 %reply.room, ptr @.json, ptr %json.values)
// CHECK:         %http_reply_text = call i32 @fminus_web_http_reply_text_s(ptr %{{.*}}, i32 200, ptr @.str{{.*}}, i32 10, ptr @.str{{.*}}, i32 8, ptr %format.values, i32 1, ptr %format.texts, ptr %format.lengths, i32 2)
// CHECK: declare ptr @fminus_web_http_text(ptr captures(none), i32, ptr writeonly captures(none)) [[READ:#[0-9]+]]
// CHECK: declare ptr @fminus_web_http_header(ptr captures(none), ptr readonly captures(none), i32, ptr writeonly captures(none)) [[READ]]
// CHECK: declare ptr @fminus_web_http_path(ptr captures(none), ptr writeonly captures(none)) [[READ]]
// CHECK: declare i32 @fminus_web_http_reply_text_s(ptr captures(none), i32, ptr readonly captures(none), i32, ptr readonly captures(none), i32, ptr readonly captures(none), i32, ptr readonly captures(none), ptr readonly captures(none), i32) [[REPLY:#[0-9]+]]
// CHECK: attributes [[READ]] = { nofree nounwind willreturn memory(argmem: readwrite, inaccessiblemem: readwrite) }
// CHECK: attributes [[REPLY]] = { nofree nounwind willreturn }
// CHECK: !{!"preset", !"string", !"path", ![[NONE:[0-9]+]], ![[NONE]], ![[NONE]], ![[NONE]]}
// CHECK: !{!"mode", !"string", !"query", ![[NONE]], ![[NONE]], ![[NONE]], ![[FULL:[0-9]+]]}
// CHECK: ![[FULL]] = !{!"full"}

