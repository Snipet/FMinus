// serve, route and reply's errors (src/ir/Serve.cpp, src/ir/WebServer.cpp), each once, at its column: a serve with a
// timeout in a nonblocking function (it blocks, as http_accept does), a route's literal and parameters, a route that
// can end without a reply, what a route's block may not do, a reply outside a route or in no form, a JSON literal's
// values and a JSON literal anywhere but a reply, and two routes one request could match, with a note at the first.
// REQUIRES: web-server
// RUN: not fminus %s 2>&1 | FileCheck %s --implicit-check-not=error: --implicit-check-not=note:

module M
{
    http_server server;
    float gain;

    void process() [[clang::nonblocking]]
    {
        serve (server, 10)
        {
            route "POST /gain/%d" (float value) { gain = value; reply 204; }
            route "POST /a/{k}" (float k, int k2 [[fminus::range(1, 0)]]) { reply 204; }
            route "GET /b" (int n) { if (n > 0) reply 200; }
            route "GET /c" { return; }
            route "GET /d" { reply 200, json { "x": server }; }
            route "GET /e" { reply 200, "text/plain"; }
        }
        reply 204;
    }

    float level() { return json { "gain": gain }; }

    void load()
    {
        serve (server) { route "GET /f/{x}/2" (int x) { reply 1; } route "GET /f/1/{y}" (int y) { reply 1; } }
    }
};

// CHECK: serve-errors.fm:15:9: error: function with 'nonblocking' attribute must not call non-'nonblocking' function 'http_accept'
// CHECK: serve-errors.fm:17:31: error: a route statement writes a hole as {name}, a parameter's name: %d is http_is's spelling
// CHECK: serve-errors.fm:18:40: error: parameter 'k' fills the hole {k}, a number of the path: it is an int, not 'float'
// CHECK: serve-errors.fm:18:52: error: fminus::range's minimum must be below its maximum
// CHECK: serve-errors.fm:19:60: error: route 'GET /b' does not reply in all control paths
// CHECK: serve-errors.fm:20:30: error: cannot return from a route: a route ends with a reply
// CHECK: serve-errors.fm:21:53: error: a JSON literal's value is a float, a double, an int, a bool, an object or an array, not 'http_server'
// CHECK: serve-errors.fm:22:30: error: no form of reply takes 2 values: a reply is 'reply status;', 'reply status, data, bytes, "type";', 'reply status, "type", "format", values...;' or 'reply status, json { ... };'
// CHECK: serve-errors.fm:24:9: error: 'reply' statement not in a route
// CHECK: serve-errors.fm:27:28: error: FMinus has no JSON values: a JSON literal is only a reply's body, 'reply status, json { ... };'
// CHECK: serve-errors.fm:31:74: error: route 'GET /f/1/{y}' conflicts with 'GET /f/{x}/2': GET /f/1/2 matches both, and neither is more specific than the other
// CHECK: serve-errors.fm:31:32: note: the other route is here
