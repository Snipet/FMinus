// An entry point under --denormals=flush on arm64 (src/ir/Denormals.cpp): its wrapper reads FPCR, and unless FZ (bit
// 24, 0x1000000) is set already, sets it, calls the body and writes FPCR back as it was; when it is, it only calls the
// body (from -O1, a tail call). It calls the body through its address passed through an empty inline asm, a call of a
// function LLVM cannot see, which no pass moves across a write of FPCR: gate's body touches no memory, and at -O1
// InstCombine sank a plain call of it below the MSR that restores FPCR. In the machine code, at each level, MRS, and
// MSR, BLR, MSR on the path that sets FZ: the body is never inlined into it. A nonblocking method the program calls
// (OnePole::tick) has no wrapper, and under preserve nothing touches FPCR. (x86-64's MXCSR wrapper is checked in
// tests/unit/DenormalTest.cpp, from its IR.)
// REQUIRES: arm64
// RUN: fminus %s -O0 --denormals=flush | FileCheck %s --implicit-check-not=tick.body
// RUN: fminus %s -O0 --denormals=flush --emit asm -o - | FileCheck %s --check-prefix=ASM-O0
// RUN: fminus %s -O1 --denormals=flush --emit asm -o - | FileCheck %s --check-prefix=ASM
// RUN: fminus %s --denormals=flush --emit asm -o - | FileCheck %s --check-prefix=ASM
// RUN: fminus %s -O3 --denormals=flush --emit asm -o - | FileCheck %s --check-prefix=ASM
// RUN: fminus %s --emit asm -o - | FileCheck %s --check-prefix=PRESERVE --implicit-check-not=FPCR

module OnePole
{
    float y;
    float k;

    float tick(float x) [[clang::nonblocking]]
    {
        return y += k * (x - y);
    }

    void process(const float* restrict in, float* restrict out, int n) [[clang::nonblocking]]
    {
        for (int i = 0; i < n; ++i)
            out[i] = tick(in[i]);
    }
};

bool gate(bool on, float x) [[clang::nonblocking]]
{
    return on && x > 0;
}

// CHECK:      define float @"OnePole::tick"(
// CHECK:      define internal void @"OnePole::process.body"(
// CHECK:      define internal zeroext i1 @gate.body(i1 zeroext %on, float %x)
// CHECK-LABEL: define void @"OnePole::process"(ptr nonnull {{.*}} %this, ptr noalias %in, ptr noalias %out, i32 %n)
// CHECK-NEXT: entry:
// CHECK-NEXT:   %fpcr = call i64 @llvm.aarch64.get.fpcr()
// CHECK-NEXT:   %fpcr.fz = or i64 %fpcr, 16777216
// CHECK-NEXT:   %flushing = icmp eq i64 %fpcr, %fpcr.fz
// CHECK-NEXT:   %body = call ptr asm "", "=r,0"(ptr @"OnePole::process.body") #[[PURE:[0-9]+]]
// CHECK-NEXT:   br i1 %flushing, label %run, label %flush
// CHECK-EMPTY:
// CHECK-NEXT: run:
// CHECK-NEXT:   call void %body(ptr nonnull {{.*}} %this, ptr noalias %in, ptr noalias %out, i32 %n)
// CHECK-NEXT:   ret void
// CHECK-EMPTY:
// CHECK-NEXT: flush:
// CHECK-NEXT:   call void @llvm.aarch64.set.fpcr(i64 %fpcr.fz)
// CHECK-NEXT:   call void %body(ptr nonnull {{.*}} %this, ptr noalias %in, ptr noalias %out, i32 %n)
// CHECK-NEXT:   call void @llvm.aarch64.set.fpcr(i64 %fpcr)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
// CHECK-LABEL: define zeroext i1 @gate(i1 zeroext %on, float %x)
// CHECK:        %body = call ptr asm "", "=r,0"(ptr @gate.body) #[[PURE]]
// CHECK:        %result = call zeroext i1 %body(i1 zeroext %on, float %x)
// CHECK-NEXT:   ret i1 %result
// CHECK:        call void @llvm.aarch64.set.fpcr(i64 %fpcr.fz)
// CHECK-NEXT:   %flushed = call zeroext i1 %body(i1 zeroext %on, float %x)
// CHECK-NEXT:   call void @llvm.aarch64.set.fpcr(i64 %fpcr)
// CHECK-NEXT:   ret i1 %flushed
// CHECK:      attributes #[[PURE]] = { nounwind willreturn memory(none) }

// From -O1 the same shape at every level: the body's address (from the GOT, as the driver's target machine addresses
// it), the test, the tail call through it when the caller flushes already, and otherwise the call between the writes.
// ASM-LABEL: OnePole::process{{"?}}:
// ASM:         mrs [[SAVED:x[0-9]+]], FPCR
// ASM-NEXT:    orr [[FZ:x[0-9]+]], [[SAVED]], #0x1000000
// ASM:         {{ldr|add}} [[BODY:x[0-9]+]], {{.*}}OnePole::process.body{{"?}}@{{(GOT)?}}PAGEOFF
// ASM:         cmp [[SAVED]], [[FZ]]
// ASM-NEXT:    b.ne [[SET:[A-Za-z0-9_]+]]
// ASM-NOT:     msr
// ASM:         br [[BODY]]
// ASM-NEXT:  [[SET]]:
// ASM-NEXT:    msr FPCR, [[FZ]]
// ASM-NEXT:    blr [[BODY]]
// ASM-NEXT:    msr FPCR, [[SAVED]]
// ASM-LABEL: gate:
// ASM:         mrs [[SAVED:x[0-9]+]], FPCR
// ASM-NEXT:    orr [[FZ:x[0-9]+]], [[SAVED]], #0x1000000
// ASM:         {{ldr|add}} [[BODY:x[0-9]+]], {{.*}}gate.body@{{(GOT)?}}PAGEOFF
// ASM:         cmp [[SAVED]], [[FZ]]
// ASM-NEXT:    b.ne [[SET:[A-Za-z0-9_]+]]
// ASM-NOT:     msr
// ASM:         br [[BODY]]
// ASM-NEXT:  [[SET]]:
// ASM-NEXT:    msr FPCR, [[FZ]]
// ASM-NEXT:    blr [[BODY]]
// ASM-NEXT:    msr FPCR, [[SAVED]]

// At -O0 every value goes through the stack, and the order is the same: no write on the first path, then the write,
// the call, the restore.
// ASM-O0-LABEL: gate:
// ASM-O0:         mrs {{x[0-9]+}}, FPCR
// ASM-O0:         b.ne [[SET:[A-Za-z0-9_]+]]
// ASM-O0-NOT:     msr
// ASM-O0:         blr {{x[0-9]+}}
// ASM-O0:         ret
// ASM-O0-NEXT:  [[SET]]:
// ASM-O0:         msr FPCR,
// ASM-O0-NOT:     bl
// ASM-O0:         blr {{x[0-9]+}}
// ASM-O0-NOT:     bl
// ASM-O0:         msr FPCR,
// ASM-O0:         ret

// PRESERVE:  OnePole::process{{"?}}:
// PRESERVE:  gate:
