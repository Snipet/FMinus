// In a build without the web server (FMINUS_WEB_SERVER=OFF, the default, with or without FMINUS_WEB), each of its
// builtins is still a name FMinus knows: its call (and a serve) is an error that names the option, not an undeclared
// function; __FMINUS_WEB_SERVER__ is not defined; and the driver's server options say the build has no server.
// UNSUPPORTED: web-server
// RUN: not fminus %s 2>&1 | FileCheck %s --implicit-check-not=error:
// RUN: not fminus %s --run taker --web-listen 127.0.0.1:0 2>&1 | FileCheck %s --check-prefix=LISTEN
// RUN: not fminus %s --run taker --web-root %S 2>&1 | FileCheck %s --check-prefix=ROOT

#ifdef __FMINUS_WEB_SERVER__
#error __FMINUS_WEB_SERVER__ is defined
#endif

int taker(const float* data)
{
    void* s = http_listen();
    void* r = http_next(s);
    void* a = http_accept(s, 100);
    int n = http_port(s) + http_arg(r, 0) + http_query_int(r, "n", 0) + (http_is(r, "GET /") ? 1 : 0);
    float g = http_query_float(r, "g", 0.0f);
    n = n + http_reply(r, 204) + http_reply_bytes(a, 200, data, 4, "") + http_reply_text(a, 200, "", "%g", g);
    return n;
}

void served(void* s) [[clang::nonblocking]]
{
    serve (s) { route "GET /a/{n}" (int n) { reply 200, json { n }; } }
    serve (s, 10) { route "GET /b" { reply 204; } }
}

