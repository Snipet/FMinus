// Field attributes' errors, one each, in clang's words where clang has them: FMinus's own where they do not apply or
// take other arguments (fminus::default on a field, which starts at 0; fminus::range on a field of no numbers, or with
// a string), one of its namespace it does not have, clang's (a function's) on a field, a number C does not write, and
// a local's or a constant's (a module's fields and parameters take attributes, for the host). A host's attribute is no
// error, and a name without a namespace that C23 does not have is clang's warning, which the program compiles with.
// And the scanner's and the parser's: a string not closed, an unknown escape, a string where an expression goes
// (FMinus's strings are an attribute's arguments only), and an attribute after an array's size (C23's for its type).
// RUN: not fminus %s 2>&1 | FileCheck %s --implicit-check-not=error:
// RUN: echo 'module M { float x [[ui::label("open)]]; };' | not fminus - 2>&1 | FileCheck %s --check-prefix=OPEN
// RUN: echo 'module M { float x [[ui::label("\q")]]; };' | not fminus - 2>&1 | FileCheck %s --check-prefix=ESCAPE
// RUN: echo 'float f() { return "x"; }' | not fminus - 2>&1 | FileCheck %s --check-prefix=STRING
// RUN: echo 'module M { float taps[16] [[ui::hidden]]; };' | not fminus - 2>&1 | FileCheck %s --check-prefix=TYPE
// RUN: echo 'module M { param float x [[range(0, 1)]]; };' | fminus - 2>&1 | FileCheck %s --check-prefix=WARN --implicit-check-not=error:

module Osc { float phase; };

module Errors
{
    float a [[fminus::default(1)]] [[ui::unit("dB")]];
    Osc o [[fminus::range(0, 1)]];
    float b [[fminus::range(0, "1")]];
    float c [[fminus::smooth(5)]];
    float d [[clang::nonblocking]];
    float e [[ui::step(08)]];
    param float g [[fminus::default("0")]];

    float tick(float x)
    {
        float y [[ui::unit("dB")]] = x;
        return y;
    }
};

const float k [[ui::unit("dB")]] = 1;

// CHECK: field-attributes-errors.fm:19:15: error: 'fminus::default' attribute only applies to parameters: a field starts at 0, and a method such as init sets it
// CHECK: field-attributes-errors.fm:20:13: error: 'fminus::range' attribute only applies to fields of numbers (float, double, int, a float vector and arrays of them), not 'Osc'
// CHECK: field-attributes-errors.fm:21:15: error: 'fminus::range' takes two numbers, a minimum and a maximum
// CHECK: field-attributes-errors.fm:22:15: error: unknown attribute 'fminus::smooth': a field takes fminus::range(min, max)
// CHECK: field-attributes-errors.fm:23:15: error: 'clang::nonblocking' attribute only applies to functions
// CHECK: field-attributes-errors.fm:24:15: error: invalid number '08' in 'ui::step'
// CHECK: field-attributes-errors.fm:25:21: error: 'fminus::default' takes one number
// CHECK: field-attributes-errors.fm:29:19: error: 'ui::unit' attribute only applies to a module's fields and parameters
// CHECK: field-attributes-errors.fm:34:17: error: 'ui::unit' attribute only applies to a module's fields and parameters

// OPEN: <stdin>:1:32: error: missing terminating '"' character
// ESCAPE: <stdin>:1:33: error: unknown escape sequence '\q'
// STRING: <stdin>:1:20: error: syntax error, unexpected string literal
// TYPE: <stdin>:1:29: error: 'ui::hidden' attribute cannot be applied to types: the attributes of 'taps' go after its name, before its size
// WARN: <stdin>:1:28: warning: unknown attribute 'range' ignored [-Wunknown-attributes]
// WARN-NEXT: <stdin>:1:28: note: did you mean 'fminus::range'?
