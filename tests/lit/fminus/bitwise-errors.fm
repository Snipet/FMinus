// The bitwise operators take ints (and bools, as ints): a float, a vector or a pointer operand is clang's error, at
// the operator. A compound assignment's stores nothing after its operator's error, so it reports one.
// RUN: not fminus %s 2>&1 | FileCheck %s --implicit-check-not=error:

int f(float x, int i, float4 v, float* p)
{
    int a = x | 1;
    int b = i >> 0.5f;
    x ^= 2;
    p &= 1;
    return a + b + ~x + ~v + (p << 1);
}

// CHECK: bitwise-errors.fm:7:15: error: invalid operands to binary expression ('float' and 'int')
// CHECK: bitwise-errors.fm:8:15: error: invalid operands to binary expression ('int' and 'float')
// CHECK: bitwise-errors.fm:9:7: error: invalid operands to binary expression ('float' and 'int')
// CHECK: bitwise-errors.fm:10:7: error: invalid operands to binary expression ('float *' and 'int')
// CHECK: bitwise-errors.fm:11:20: error: invalid argument type 'float' to unary expression
// CHECK: bitwise-errors.fm:11:25: error: invalid argument type 'float4' to unary expression
// CHECK: bitwise-errors.fm:11:33: error: invalid operands to binary expression ('float *' and 'int')
