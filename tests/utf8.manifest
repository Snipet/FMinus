<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- tests/utf8.manifest: the Catch2 executables' code page on Windows (tests/CMakeLists.txt). UTF-8 as the process's
     active code page (Windows 10 1903 and later; earlier versions ignore it), so the C runtime gives main its arguments
     in UTF-8: ctest names a test by its whole name, and a name that is not ASCII (a section sign, say) then matches
     the TEST_CASE's own UTF-8 bytes. Without it the name arrives in the console's code page and matches no test. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application>
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
